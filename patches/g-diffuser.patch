+
+/* Deterministic host clock. One VI is exactly 781250 N64 counter cycles. */
+void gdx_headless_clock_reset(unsigned long long cycles);
+void gdx_headless_clock_advance_vi(void);
+unsigned long long gdx_headless_clock_cycles(void);
