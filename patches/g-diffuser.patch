+CourseSegment* segment_at_distance(float distance, float* out_t, float* out_length_proportion) {
+    CourseInfo* course = gCurrentCourseInfo;
+    if (course == nullptr || course->courseSegments == nullptr || course->segmentCount <= 0 ||
+        !(course->length > 0.0f)) {
+        return nullptr;
+    }
+
+    distance = std::fmod(distance, course->length);
+    if (distance < 0.0f) {
+        distance += course->length;
+    }
+
+    CourseSegment* segment = &course->courseSegments[course->segmentCount - 1];
+    for (int i = 0; i < course->segmentCount; ++i) {
+        CourseSegment* candidate = &course->courseSegments[i];
+        if (distance < candidate->lengthFromStart + candidate->length || i == course->segmentCount - 1) {
+            segment = candidate;
+            break;
+        }
+    }
+
+    float low = 0.0f;
+    float high = 1.0f;
+    for (int iteration = 0; iteration < 10; ++iteration) {
+        const float middle = (low + high) * 0.5f;
+        float spline_distance = 0.0f;
+        Course_SplineGetLengthInfo(segment, middle, &spline_distance);
+        if (spline_distance < distance) {
+            low = middle;
+        } else {
+            high = middle;
+        }
+    }
+
+    const float t = (low + high) * 0.5f;
+    float ignored_distance = 0.0f;
+    const float length_proportion = Course_SplineGetLengthInfo(segment, t, &ignored_distance);
+    if (out_t != nullptr) {
+        *out_t = t;
+    }
+    if (out_length_proportion != nullptr) {
+        *out_length_proportion = length_proportion;
+    }
+    return segment;
+}
+
+float wrapped_forward_distance(float target, float current, float course_length) {
+    float distance = std::fmod(target - current, course_length);
+    if (distance < 0.0f) {
+        distance += course_length;
+    }
+    return distance;
+}
+
+float wrap_degrees_signed(float degrees) {
+    degrees = std::fmod(degrees + 180.0f, 360.0f);
+    if (degrees < 0.0f) {
+        degrees += 360.0f;
+    }
+    return degrees - 180.0f;
+}
