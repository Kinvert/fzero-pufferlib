+/* ------------------------------------------------------------------------------------------ */
+/* Cartridge DMA and inert hardware devices.                                                  */
+/* ------------------------------------------------------------------------------------------ */
+
+static OSPiHandle sHeadlessCartHandle;
+
+OSPiHandle* osCartRomInit(void) {
+    return &sHeadlessCartHandle;
+}
+
+void osCreatePiManager(OSPri pri, OSMesgQueue* cmdQ, OSMesg* cmdBuf, s32 cmdMsgCnt) {
+    (void) pri;
+    (void) cmdQ;
+    (void) cmdBuf;
+    (void) cmdMsgCnt;
+}
+
+s32 osEPiStartDma(OSPiHandle* handle, OSIoMesg* mb, s32 direction) {
+    int ok = 0;
+    (void) handle;
+    if (mb == NULL) {
+        return -1;
+    }
+    if (direction == OS_READ && mb->dramAddr != NULL && mb->size != 0) {
+        ok = GdxSegmentSourceRead(mb->devAddr, mb->size, mb->dramAddr);
+        if (!ok) {
+            memset(mb->dramAddr, 0, mb->size);
+        }
+    } else if (direction == OS_WRITE) {
+        ok = 1;
+    }
+    mb->hdr.status = ok ? 0 : 1;
+    if (mb->hdr.retQueue != NULL) {
+        osSendMesg(mb->hdr.retQueue, (OSMesg) mb, OS_MESG_NOBLOCK);
+    }
+    return ok ? 0 : -1;
+}
