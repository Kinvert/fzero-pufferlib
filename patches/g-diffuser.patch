+        case TRACK_SHAPE_ROAD:
+        case TRACK_SHAPE_WALLED_ROAD:
+        case TRACK_SHAPE_TUNNEL:
+        case TRACK_SHAPE_BORDERLESS_ROAD:
+            return true;
+        default:
+            return false;
+    }
+}
+
+float curved_dash_neutral_angle(int shape) {
+    switch (shape) {
+        case TRACK_SHAPE_PIPE:
+            return 22.5f;
+        case TRACK_SHAPE_CYLINDER:
+            return 202.5f;
+        case TRACK_SHAPE_HALF_PIPE:
+        default:
+            return 0.0f;
+    }
+}
+
+bool build_dash_pad_cache() {
+    sDashPadCount = 0;
+    if (gCurrentCourseInfo == nullptr || gCurrentCourseInfo->courseSegments == nullptr ||
+        gCurrentCourseInfo->segmentCount <= 0 || !(gCurrentCourseInfo->length > 0.0f)) {
+        set_error("cannot build dash-pad cache before course initialization");
+        return false;
+    }
+    if (gCourseEffectsInfo.count < 0 || gCourseEffectsInfo.count > GDX_RL_MAX_DASH_PADS ||
+        (gCourseEffectsInfo.count > 0 && gCourseEffectsInfo.effects == nullptr)) {
+        set_error("invalid course-effect table while building dash-pad cache");
+        return false;
+    }
+
+    for (int i = 0; i < gCourseEffectsInfo.count; ++i) {
+        const CourseEffect& source = gCourseEffectsInfo.effects[i];
+        if (source.effectType != COURSE_EFFECT_DASH) {
+            continue;
+        }
+        if (source.segmentIndex < 0 || source.segmentIndex >= gCurrentCourseInfo->segmentCount ||
+            sDashPadCount >= GDX_RL_MAX_DASH_PADS) {
+            set_error("dash pad references an invalid course segment or exceeds capacity");
+            return false;
+        }
+
+        CourseSegment* segment = &gCurrentCourseInfo->courseSegments[source.segmentIndex];
+        const Effect& runtime_effect = gEffects[i];
+        if (runtime_effect.effectType != COURSE_EFFECT_DASH ||
+            !std::isfinite(runtime_effect.segmentTValueStart)) {
+            set_error("runtime dash-pad geometry is not initialized");
+            return false;
+        }
+
+        float entry_distance = 0.0f;
+        const float length_proportion = Course_SplineGetLengthInfo(
+            segment, runtime_effect.segmentTValueStart, &entry_distance);
+        const float radius_left = segment->radiusLeft +
+            (segment->next->radiusLeft - segment->radiusLeft) * length_proportion;
+        const float radius_right = segment->radiusRight +
+            (segment->next->radiusRight - segment->radiusRight) * length_proportion;
+        const float full_width = radius_left + radius_right;
+        if (!std::isfinite(entry_distance) || !std::isfinite(length_proportion) ||
+            !std::isfinite(radius_left) || !std::isfinite(radius_right) ||
+            !(full_width > 0.0f)) {
+            set_error("dash-pad geometry contains a nonfinite or nonpositive value");
+            return false;
+        }
+
+        const int shape = segment->trackSegmentInfo & TRACK_SHAPE_MASK;
+        float target = 0.0f;
+        float half_width = 50.0f;
+        if (flat_dash_shape(shape)) {
+            const float right_edge = runtime_effect.unk_0C.x;
+            const float left_edge = runtime_effect.unk_18.x;
+            /* Racer collision shifts its lateral coordinate by half the asymmetric-width
+               difference. Undo that shift so target uses observation[4]'s bare track-left
+               displacement convention. */
+            const float center = 0.5f * (right_edge + left_edge) -
+                                 0.5f * (radius_right - radius_left);
+            half_width = 0.5f * std::fabs(left_edge - right_edge);
+            const float side_radius = std::max(1.0f, center >= 0.0f ? radius_left : radius_right);
+            target = center / side_radius;
+        } else {
+            target = wrap_degrees_signed(
+                source.rightEdgeDistance - curved_dash_neutral_angle(shape)) / 180.0f;
+        }
+        if (!std::isfinite(target) || !std::isfinite(half_width) || !(half_width > 0.0f)) {
+            set_error("dash-pad target or width is invalid");
+            return false;
+        }
+
+        entry_distance = std::fmod(entry_distance, gCurrentCourseInfo->length);
+        if (entry_distance < 0.0f) {
+            entry_distance += gCurrentCourseInfo->length;
+        }
+        GdxRlDashPad& pad = sDashPads[sDashPadCount++];
+        pad.entry_distance = entry_distance;
+        pad.target = std::max(-1.0f, std::min(1.0f, target));
+        pad.width = std::max(0.0f, std::min(1.0f, half_width / (0.5f * full_width)));
+        pad.segment_index = static_cast<uint32_t>(source.segmentIndex);
+    }
+
+    std::sort(sDashPads, sDashPads + sDashPadCount,
+              [](const GdxRlDashPad& a, const GdxRlDashPad& b) {
+                  if (a.entry_distance != b.entry_distance) {
+                      return a.entry_distance < b.entry_distance;
+                  }
+                  return a.segment_index < b.segment_index;
+              });
+    return true;
+}
+
+void observe_next_dash(float lap_distance, float course_length, float output[4]) {
+    output[0] = 0.0f;
+    output[1] = 0.0f;
+    output[2] = 0.0f;
+    output[3] = 0.0f;
+    if (sDashPadCount == 0) {
+        return;
+    }
+
+    uint32_t nearest = 0;
+    float nearest_distance = course_length;
+    for (uint32_t i = 0; i < sDashPadCount; ++i) {
+        const float distance = wrapped_forward_distance(
+            sDashPads[i].entry_distance, lap_distance, course_length);
+        if (distance < nearest_distance) {
+            nearest = i;
+            nearest_distance = distance;
+        }
+    }
+    output[0] = 1.0f;
+    output[1] = clamp_zero_one(nearest_distance / kDashObservationRange);
+    output[2] = sDashPads[nearest].target;
+    output[3] = sDashPads[nearest].width;
+}
+
+bool observe(float observation[GDX_RL_OBSERVATION_SIZE]) {
+    if (observation == nullptr) {
+        set_error("observation pointer is null");
+        return false;
+    }
+    if (gTotalRacers != 1 || gCurrentCourseInfo == nullptr || !(gCurrentCourseInfo->length > 0.0f)) {
+        set_error("race state is not initialized");
+        return false;
+    }
+
+    const Racer& racer = gRacers[0];
+    sObservationSourceFinite = true;
+    const float forward_velocity = dot(racer.velocity, racer.segmentBasis.x);
+    const float left_velocity = dot(racer.velocity, racer.segmentBasis.z);
+    const float up_velocity = dot(racer.velocity, racer.segmentBasis.y);
+    const float lateral = dot(racer.segmentPositionInfo.segmentDisplacement, racer.segmentBasis.z);
+    const float vertical = dot(racer.segmentPositionInfo.segmentDisplacement, racer.segmentBasis.y);
+    float current_radius_left = racer.currentRadiusLeft;
+    float current_radius_right = racer.currentRadiusRight;
+    if (!std::isfinite(current_radius_left) || !std::isfinite(current_radius_right)) {
+        sObservationSourceFinite = false;
+        if (!std::isfinite(current_radius_left)) current_radius_left = 1.0f;
+        if (!std::isfinite(current_radius_right)) current_radius_right = 1.0f;
+    }
+    const float lateral_radius =
+        std::max(1.0f, lateral >= 0.0f ? current_radius_left : current_radius_right);
+    const float vertical_radius = std::max(1.0f, std::max(current_radius_left, current_radius_right));
+    const float course_length = gCurrentCourseInfo->length;
+    const float race_length = course_length * std::max(1, gTotalLapCount);
+    int index = 0;
+
+    observation[index++] = clamp_unit(forward_velocity / kMaxSpeed);
+    observation[index++] = clamp_unit(left_velocity / kMaxSpeed);
+    observation[index++] = clamp_unit(up_velocity / kMaxSpeed);
+    observation[index++] = clamp_zero_one(racer.speed / kMaxSpeed);
+    observation[index++] = clamp_unit(std::max(-1.25f, std::min(1.25f, lateral / lateral_radius)) / 1.25f);
+    observation[index++] = clamp_unit(vertical / vertical_radius);
+    observation[index++] = encode_radius(current_radius_left);
+    observation[index++] = encode_radius(current_radius_right);
+
+    observation[index++] = clamp_unit(dot(racer.trueBasis.x, racer.segmentBasis.x));
+    observation[index++] = clamp_unit(dot(racer.trueBasis.x, racer.segmentBasis.z));
+    observation[index++] = clamp_unit(dot(racer.trueBasis.x, racer.segmentBasis.y));
+    observation[index++] = clamp_unit(dot(racer.trueBasis.y, racer.segmentBasis.y));
+    observation[index++] = clamp_unit(dot(racer.trueBasis.y, racer.segmentBasis.z));
+    observation[index++] = encode_energy_fraction(racer.energy, racer.maxEnergy);
+    observation[index++] = clamp_zero_one(static_cast<float>(racer.boostTimer) / 100.0f);
+    observation[index++] = clamp_zero_one(racer.lapDistance / course_length);
+    observation[index++] = clamp_zero_one(racer.raceDistance / race_length);
+    observation[index++] = (racer.stateFlags & RACER_STATE_CAN_BOOST) != 0 ? 1.0f : 0.0f;
+    observation[index++] = (racer.stateFlags & RACER_STATE_AIRBORNE) != 0 ? 1.0f : 0.0f;
+    observation[index++] = racer.boostTimer > 0 ? 1.0f : 0.0f;
+    observation[index++] = (racer.stateFlags & RACER_STATE_COLLISION_RECOIL) != 0 ? 1.0f : 0.0f;
+    observation[index++] = sDamageDuringDecision ? 1.0f : 0.0f;
+
+    const int effect = racer.stateFlags & COURSE_EFFECT_MASK;
+    observation[index++] = effect == COURSE_EFFECT_PIT ? 1.0f : 0.0f;
+    observation[index++] = effect == COURSE_EFFECT_DIRT ? 1.0f : 0.0f;
+    observation[index++] = effect == COURSE_EFFECT_DASH ? 1.0f : 0.0f;
+    observation[index++] = effect == COURSE_EFFECT_ICE ? 1.0f : 0.0f;
+
+    observation[index++] = static_cast<float>(kSteerValues[sPreviousAction[0]]) / 63.0f;
+    observation[index++] = static_cast<float>(kPitchValues[sPreviousAction[1]]) / 63.0f;
+    observation[index++] = static_cast<float>(sPreviousAction[2]);
+    observation[index++] = static_cast<float>(sPreviousAction[3]);
+    observation[index++] = static_cast<float>(sPreviousAction[4]);
+
+    for (float offset : kLookaheadOffsets) {
+        float t = 0.0f;
+        float length_proportion = 0.0f;
+        CourseSegment* future_segment =
+            segment_at_distance(racer.lapDistance + offset, &t, &length_proportion);
+        if (future_segment == nullptr) {
+            set_error("failed to resolve course lookahead segment");
+            return false;
+        }
+
+        Vec3f future_position;
+        Mtx3F future_basis;
+        Course_SplineGetPosition(future_segment, t, &future_position);
+        Course_SplineGetBasis(future_segment, t, &future_basis, length_proportion);
+        Vec3f displacement = {
+            future_position.x - racer.segmentPositionInfo.pos.x,
+            future_position.y - racer.segmentPositionInfo.pos.y,
+            future_position.z - racer.segmentPositionInfo.pos.z,
+        };
+        const float left_radius = future_segment->radiusLeft +
+                                  (future_segment->next->radiusLeft - future_segment->radiusLeft) * length_proportion;
+        const float right_radius = future_segment->radiusRight +
+                                   (future_segment->next->radiusRight - future_segment->radiusRight) * length_proportion;
+
+        observation[index++] = clamp_unit(dot(displacement, racer.segmentBasis.x) / offset);
+        observation[index++] = clamp_unit(dot(displacement, racer.segmentBasis.z) / offset);
+        observation[index++] = clamp_unit(dot(displacement, racer.segmentBasis.y) / offset);
+        observation[index++] = clamp_unit(dot(future_basis.x, racer.segmentBasis.x));
+        observation[index++] = clamp_unit(dot(future_basis.x, racer.segmentBasis.z));
+        observation[index++] = clamp_unit(dot(future_basis.x, racer.segmentBasis.y));
+        observation[index++] = encode_radius(left_radius);
+        observation[index++] = encode_radius(right_radius);
+    }
+
+    float next_dash[4];
+    observe_next_dash(racer.lapDistance, course_length, next_dash);
+    for (float value : next_dash) {
+        observation[index++] = value;
+    }
+
+    if (index != GDX_RL_OBSERVATION_SIZE) {
+        set_errorf("internal observation size mismatch: %d", index);
+        return false;
+    }
+    if (!sObservationSourceFinite) {
+        set_error("nonfinite game state encountered while constructing observation");
+        return false;
+    }
+    for (int i = 0; i < GDX_RL_OBSERVATION_SIZE; ++i) {
+        if (!std::isfinite(observation[i]) || observation[i] < -1.00001f || observation[i] > 1.00001f) {
+            set_errorf("invalid normalized observation at index %d", i);
+            return false;
+        }
+    }
+    return true;
+}
+
+void hash_bytes(uint64_t* hash, const void* data, size_t size) {
+    const auto* bytes = static_cast<const uint8_t*>(data);
+    for (size_t i = 0; i < size; ++i) {
+        *hash ^= bytes[i];
+        *hash *= kFnvPrime;
+    }
+}
+
+template <typename T>
+void hash_value(uint64_t* hash, const T& value) {
+    hash_bytes(hash, &value, sizeof(value));
+}
+
+uint64_t semantic_hash_impl() {
+    const Racer& racer = gRacers[0];
+    uint64_t hash = kFnvOffset;
+    const int segment_index = racer.segmentPositionInfo.courseSegment != nullptr
+                                  ? racer.segmentPositionInfo.courseSegment->segmentIndex
+                                  : -1;
+    const int control_port = gPlayerControlPorts[0];
+    const Controller& controller =
+        gControllers[(control_port >= PORT_1 && control_port <= PORT_DISCONNECTED) ? control_port : PORT_1];
+    const uint32_t schema_version = 2;
+
+    hash_value(&hash, schema_version);
+    hash_value(&hash, sConfig.course_index);
+    hash_value(&hash, sConfig.character);
+    hash_value(&hash, sConfig.machine_skin);
+    hash_value(&hash, sConfig.laps);
+    hash_value(&hash, sConfig.action_repeat);
+    hash_value(&hash, sConfig.max_episode_frames);
+    hash_value(&hash, sConfig.stall_frames);
+    hash_value(&hash, sConfig.stall_progress);
+    hash_value(&hash, sConfig.engine_balance);
+    hash_value(&hash, sConfig.cpu_oracle);
+    hash_value(&hash, gGameMode);
+    hash_value(&hash, gGameModeChangeState);
