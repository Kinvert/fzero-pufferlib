+int gdx_load_rom_explicit_us_rev0(const char* path) {
+    if (path == nullptr || path[0] == '\0' || gdx_rom_buffer != nullptr) {
+        return -1;
+    }
+    load_rom(path);
+    if (gdx_rom_buffer == nullptr) {
