+extern "C" int gdx_rl_export_reference_state(GdxRlReferenceState* state) {
+    if (!on_owner_thread()) {
+        return -1;
+    }
+    if (state == nullptr) {
+        set_error("reference state pointer is null");
+        return -1;
+    }
+    if (!sEpisodeReady || gTotalRacers != 1) {
+        set_error("reference state export requires a successful episode reset");
+        return -1;
+    }
+
+    const Racer& racer = gRacers[0];
+    std::memset(state, 0, sizeof(*state));
+    state->version = GDX_RL_COURSE_EXPORT_VERSION;
+    state->state_flags = static_cast<uint32_t>(racer.stateFlags);
+    state->boost_timer = racer.boostTimer;
+    state->lap = racer.lap;
+    state->laps_completed = racer.lapsCompleted;
+    const Vec3f* vectors[] = {
+        &racer.segmentPositionInfo.pos,
+        &racer.velocity,
+    };
+    float* vector_outputs[] = { state->position, state->velocity };
+    for (int i = 0; i < 2; ++i) {
+        vector_outputs[i][0] = vectors[i]->x;
+        vector_outputs[i][1] = vectors[i]->y;
+        vector_outputs[i][2] = vectors[i]->z;
+    }
+    const Mtx3F* bases[] = { &racer.trueBasis, &racer.segmentBasis };
+    float* basis_outputs[] = { state->true_basis, state->segment_basis };
+    for (int basis_index = 0; basis_index < 2; ++basis_index) {
+        const Vec3f* axes[] = {
+            &bases[basis_index]->x,
+            &bases[basis_index]->y,
+            &bases[basis_index]->z,
+        };
+        for (int axis = 0; axis < 3; ++axis) {
+            basis_outputs[basis_index][axis * 3 + 0] = axes[axis]->x;
+            basis_outputs[basis_index][axis * 3 + 1] = axes[axis]->y;
+            basis_outputs[basis_index][axis * 3 + 2] = axes[axis]->z;
+        }
+    }
+    state->speed = racer.speed;
+    state->max_speed = racer.maxSpeed;
+    state->energy = racer.energy;
+    state->max_energy = racer.maxEnergy;
+    state->race_distance = racer.raceDistance;
+    state->lap_distance = racer.lapDistance;
+    state->lateral = dot(racer.segmentPositionInfo.segmentDisplacement, racer.segmentBasis.z);
+    state->vertical = dot(racer.segmentPositionInfo.segmentDisplacement, racer.segmentBasis.y);
+    state->radius_left = racer.currentRadiusLeft;
+    state->radius_right = racer.currentRadiusRight;
+    if (!observe(state->observation)) {
+        return -1;
+    }
+    return 0;
+}
+
+extern "C" uint64_t gdx_rl_semantic_hash(void) {
+    if (!on_owner_thread() || gTotalRacers != 1) {
+        return 0;
+    }
+    return semantic_hash_impl();
+}
+
+extern "C" const char* gdx_rl_last_error(void) {
+    return sLastError;
+}
diff --git a/port/rl/gdx_rl_env.h b/port/rl/gdx_rl_env.h
new file mode 100644
index 0000000..b9cf69d
--- /dev/null
+++ b/port/rl/gdx_rl_env.h
@@ -0,0 +1,151 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    GDX_RL_ABI_VERSION = 3,
+    GDX_RL_COURSE_EXPORT_VERSION = 2,
+    GDX_RL_OBSERVATION_SIZE = 83,
+    GDX_RL_ACTION_SIZE = 5,
+    GDX_RL_STEER_BINS = 11,
+    GDX_RL_PITCH_BINS = 5,
+    GDX_RL_MAX_DASH_PADS = 192,
+};
+
+typedef enum GdxRlTerminationReason {
+    GDX_RL_RUNNING = 0,
+    GDX_RL_FINISHED = 1,
+    GDX_RL_SPINNING_OUT = 2,
+    GDX_RL_FALLING = 3,
+    GDX_RL_CRASHED = 4,
+    GDX_RL_RETIRED = 5,
+    GDX_RL_TIME_LIMIT = 6,
+    GDX_RL_STALLED = 7,
+} GdxRlTerminationReason;
+
+typedef struct GdxRlConfig {
+    int32_t course_index;
+    int32_t character;
+    int32_t machine_skin;
+    int32_t laps;
+    int32_t action_repeat;
+    int32_t max_episode_frames;
+    int32_t stall_frames;
+    float stall_progress;
+    float engine_balance;
+    uint8_t cpu_oracle;
+    uint8_t reserved[3];
+} GdxRlConfig;
+
+typedef struct GdxRlTransition {
+    float reward;
+    float race_distance;
+    float speed;
+    float energy_fraction;
+    uint64_t semantic_hash;
+    uint32_t episode_frame;
+    int16_t lap;
+    uint8_t terminated;
+    uint8_t truncated;
+    uint8_t reason;
+    /* Number of off-dash -> on-dash contact edges across this action repeat. */
+    uint8_t dash_pad_hits;
+    uint8_t reserved[2];
+} GdxRlTransition;
+
+/* Runtime-only, ROM-derived geometry export for reduced simulators. Callers own the output
+   storage. The samples are evenly spaced in arc length around the closed course; no sample or
+   other extracted asset is written to disk by this API. */
+typedef struct GdxRlCourseSample {
+    float distance;
+    float position[3];
+    float forward[3];
+    float up[3];
+    float side[3];
+    float radius_left;
+    float radius_right;
+    uint32_t track_segment_info;
+    int32_t segment_index;
+} GdxRlCourseSample;
+
+/* Pointer-free dash-pad descriptor shared by the exact observation packer and reduced
+   simulators. target and width use the normalized observation encoding documented below. */
+typedef struct GdxRlDashPad {
+    float entry_distance;
+    float target;
+    float width;
+    uint32_t segment_index;
+} GdxRlDashPad;
+
+typedef struct GdxRlCourseMetadata {
+    uint32_t version;
+    uint32_t sample_count;
+    uint32_t segment_count;
+    uint32_t dash_pad_count;
+    float length;
+    float sample_spacing;
+} GdxRlCourseMetadata;
+
+/* Compact live reference state used to seed and differentially test a reduced simulator. The
+   public observation remains the policy contract; these extra fields are an oracle/debug seam. */
+typedef struct GdxRlReferenceState {
+    uint32_t version;
+    uint32_t state_flags;
+    int32_t boost_timer;
+    int16_t lap;
+    int16_t laps_completed;
+    float position[3];
+    float velocity[3];
+    float true_basis[9];
+    float segment_basis[9];
+    float speed;
+    float max_speed;
+    float energy;
+    float max_energy;
+    float race_distance;
+    float lap_distance;
+    float lateral;
+    float vertical;
+    float radius_left;
+    float radius_right;
+    float observation[GDX_RL_OBSERVATION_SIZE];
+} GdxRlReferenceState;
+
+/* Action categories are [steer, pitch, throttle, brake, boost] with nvec [11,5,2,2,2].
+   Steer/pitch use neutral-first tables, so the all-zero action is a true no-op. */
+extern const int32_t gdx_rl_action_nvec[GDX_RL_ACTION_SIZE];
+
+uint32_t gdx_rl_abi_version(void);
+
+void gdx_rl_default_config(GdxRlConfig* config);
+
+/* One global game exists in each loaded module namespace. Calls must stay on its current owner
+   thread. A second instance requires a separate process or Linux dlmopen namespace. */
+int gdx_rl_init(const char* rom_path, const GdxRlConfig* config);
+/* Rebind after a sequential handoff to another OS thread (for Puffer's worker startup). The
+   caller must guarantee that no other thread is concurrently inside this module namespace. */
+int gdx_rl_bind_thread(void);
+int gdx_rl_reset(uint32_t seed, float observation[GDX_RL_OBSERVATION_SIZE]);
+int gdx_rl_step(const int32_t action[GDX_RL_ACTION_SIZE],
+                float observation[GDX_RL_OBSERVATION_SIZE], GdxRlTransition* transition);
+
+/* Export an evenly spaced, pointer-free view of the currently loaded private course. The game
+   must be initialized; reference-state export additionally requires a successful episode reset. */
+int gdx_rl_export_course(uint32_t sample_count, GdxRlCourseSample* samples,
+                         GdxRlCourseMetadata* metadata);
+/* A capacity-zero/null-pads call queries the required count. Other calls require non-null
+   storage with capacity at least that count. out_count is required in both forms. */
+int gdx_rl_export_dash_pads(uint32_t capacity, GdxRlDashPad* pads, uint32_t* out_count);
+int gdx_rl_export_reference_state(GdxRlReferenceState* state);
+
+uint64_t gdx_rl_semantic_hash(void);
+const char* gdx_rl_last_error(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/port/rl/gdx_rl_env_test.cpp b/port/rl/gdx_rl_env_test.cpp
new file mode 100644
index 0000000..203a066
--- /dev/null
+++ b/port/rl/gdx_rl_env_test.cpp
@@ -0,0 +1,502 @@
+#include "gdx_rl_env.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstddef>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+namespace {
+
+static_assert(sizeof(GdxRlTransition) == 40,
+              "GdxRlTransition ABI size changed unexpectedly");
+static_assert(offsetof(GdxRlTransition, dash_pad_hits) == 33,
+              "dash_pad_hits must occupy the former first reserved byte");
+static_assert(GDX_RL_OBSERVATION_SIZE == 83,
+              "nearest-dash observation fields must append to the 79-value v1 contract");
+static_assert(sizeof(GdxRlDashPad) == 16 && offsetof(GdxRlDashPad, entry_distance) == 0 &&
+                  offsetof(GdxRlDashPad, target) == 4 && offsetof(GdxRlDashPad, width) == 8 &&
+                  offsetof(GdxRlDashPad, segment_index) == 12,
+              "GdxRlDashPad ABI layout changed unexpectedly");
+static_assert(sizeof(GdxRlCourseMetadata) == 24 &&
+                  offsetof(GdxRlCourseMetadata, dash_pad_count) == 12,
+              "GdxRlCourseMetadata ABI layout changed unexpectedly");
+
+constexpr int kNextDashValid = 79;
+constexpr int kNextDashDistance = 80;
+constexpr int kNextDashTarget = 81;
+constexpr int kNextDashWidth = 82;
+constexpr float kDashObservationRange = 8000.0f;
+
+struct TraceItem {
+    float observation[GDX_RL_OBSERVATION_SIZE];
+    GdxRlTransition transition;
+};
+
+bool observation_valid(const float* observation) {
+    for (int i = 0; i < GDX_RL_OBSERVATION_SIZE; ++i) {
+        if (!std::isfinite(observation[i]) || observation[i] < -1.00001f || observation[i] > 1.00001f) {
+            std::fprintf(stderr, "invalid observation[%d]=%.9g\n", i, observation[i]);
+            return false;
+        }
+    }
+    if (observation[kNextDashValid] != 0.0f && observation[kNextDashValid] != 1.0f) {
+        std::fprintf(stderr, "nearest-dash valid flag is not binary\n");
+        return false;
+    }
+    if (observation[kNextDashValid] == 0.0f) {
+        if (observation[kNextDashDistance] != 0.0f || observation[kNextDashTarget] != 0.0f ||
+            observation[kNextDashWidth] != 0.0f) {
+            std::fprintf(stderr, "invalid nearest-dash sentinel values\n");
+            return false;
+        }
+    } else if (!(observation[kNextDashWidth] > 0.0f)) {
+        std::fprintf(stderr, "valid nearest-dash descriptor has nonpositive width\n");
+        return false;
+    }
+    return true;
+}
+
+float wrapped_forward_distance(float target, float current, float course_length) {
+    float distance = std::fmod(target - current, course_length);
+    if (distance < 0.0f) {
+        distance += course_length;
+    }
+    return distance;
+}
+
+bool dash_observation_matches(const float* observation, float lap_distance,
+                              const GdxRlCourseMetadata& metadata,
+                              const std::vector<GdxRlDashPad>& pads) {
+    if (pads.empty()) {
+        return observation[kNextDashValid] == 0.0f &&
+               observation[kNextDashDistance] == 0.0f &&
+               observation[kNextDashTarget] == 0.0f &&
+               observation[kNextDashWidth] == 0.0f;
+    }
+
+    size_t nearest = 0;
+    float nearest_distance = metadata.length;
+    for (size_t i = 0; i < pads.size(); ++i) {
+        const float distance = wrapped_forward_distance(
+            pads[i].entry_distance, lap_distance, metadata.length);
+        if (distance < nearest_distance) {
+            nearest = i;
+            nearest_distance = distance;
+        }
+    }
+    const float expected_distance = std::min(1.0f, nearest_distance / kDashObservationRange);
+    return observation[kNextDashValid] == 1.0f &&
+           std::fabs(observation[kNextDashDistance] - expected_distance) < 1.0e-5f &&
+           std::fabs(observation[kNextDashTarget] - pads[nearest].target) < 1.0e-6f &&
+           std::fabs(observation[kNextDashWidth] - pads[nearest].width) < 1.0e-6f;
+}
+
+int fail(const char* operation) {
+    std::fprintf(stderr, "%s: %s\n", operation, gdx_rl_last_error());
+    return 1;
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 2 || argc > 3) {
+        std::fprintf(stderr,
+                     "usage: %s <baserom.us.rev0.z64> "
+                     "[--cpu-oracle|--observation-oracle|--observation-oracle-3lap]\n",
+                     argv[0]);
+        return 2;
+    }
+    const bool cpu_oracle = argc == 3 && std::strcmp(argv[2], "--cpu-oracle") == 0;
+    const bool observation_oracle =
+        argc == 3 && (std::strcmp(argv[2], "--observation-oracle") == 0 ||
+                      std::strcmp(argv[2], "--observation-oracle-3lap") == 0);
+    if (argc == 3 && !cpu_oracle && !observation_oracle) {
+        std::fprintf(stderr, "unknown option: %s\n", argv[2]);
+        return 2;
+    }
+
+    GdxRlConfig config;
+    gdx_rl_default_config(&config);
+    config.laps = argc == 3 && std::strcmp(argv[2], "--observation-oracle-3lap") == 0 ? 3 : 1;
+    config.cpu_oracle = cpu_oracle ? 1 : 0;
+    if (cpu_oracle) {
+        config.stall_frames = 0;
+    }
+    {
+        GdxRlConfig invalid_config = config;
+        invalid_config.stall_progress = std::numeric_limits<float>::infinity();
+        if (gdx_rl_init(argv[1], &invalid_config) == 0) {
+            std::fprintf(stderr, "infinite stall_progress was accepted\n");
+            return 1;
+        }
+        invalid_config = config;
+        invalid_config.cpu_oracle = 2;
+        if (gdx_rl_init(argv[1], &invalid_config) == 0) {
+            std::fprintf(stderr, "invalid cpu_oracle was accepted\n");
+            return 1;
+        }
+    }
+    if (gdx_rl_init(argv[1], &config) != 0) {
+        return fail("init failed");
+    }
+    if (gdx_rl_abi_version() != GDX_RL_ABI_VERSION) {
+        std::fprintf(stderr, "unexpected F-Zero RL ABI version\n");
+        return 1;
+    }
+
+    const int32_t throttle_action[GDX_RL_ACTION_SIZE] = { 0, 0, 1, 0, 0 };
+    {
+        float premature_observation[GDX_RL_OBSERVATION_SIZE];
+        GdxRlTransition premature_transition = {};
+        const uint64_t before = gdx_rl_semantic_hash();
+        if (gdx_rl_step(throttle_action, premature_observation, &premature_transition) == 0 ||
+            gdx_rl_semantic_hash() != before) {
+            std::fprintf(stderr, "step before reset was accepted or mutated state\n");
+            return 1;
+        }
+    }
+
+    constexpr uint32_t seed = 0xF20A1234u;
+    float initial_observation[GDX_RL_OBSERVATION_SIZE];
+    if (gdx_rl_reset(seed, initial_observation) != 0) {
+        return fail("reset failed");
+    }
+    if (!observation_valid(initial_observation)) {
+        return 1;
+    }
+    const uint64_t initial_hash = gdx_rl_semantic_hash();
+    GdxRlCourseMetadata course_metadata = {};
+    std::vector<GdxRlDashPad> dash_pads;
+    GdxRlReferenceState initial_reference = {};
+
+    {
+        constexpr uint32_t kCourseSamples = 257;
+        std::vector<GdxRlCourseSample> samples(kCourseSamples);
+        if (gdx_rl_export_course(kCourseSamples, samples.data(), &course_metadata) != 0) {
+            return fail("course export failed");
+        }
+        if (course_metadata.version != GDX_RL_COURSE_EXPORT_VERSION ||
+            course_metadata.sample_count != kCourseSamples || course_metadata.segment_count == 0 ||
+            course_metadata.dash_pad_count > GDX_RL_MAX_DASH_PADS ||
+            !(course_metadata.length > 0.0f) || !(course_metadata.sample_spacing > 0.0f)) {
+            std::fprintf(stderr, "invalid course export metadata\n");
+            return 1;
+        }
+        for (uint32_t i = 0; i < kCourseSamples; ++i) {
+            const GdxRlCourseSample& sample = samples[i];
+            const float forward_length = std::sqrt(
+                sample.forward[0] * sample.forward[0] +
+                sample.forward[1] * sample.forward[1] +
+                sample.forward[2] * sample.forward[2]);
+            const float up_length = std::sqrt(
+                sample.up[0] * sample.up[0] +
+                sample.up[1] * sample.up[1] +
+                sample.up[2] * sample.up[2]);
+            if (!std::isfinite(sample.distance) ||
+                !(sample.radius_left > 0.0f) || !(sample.radius_right > 0.0f) ||
+                std::fabs(forward_length - 1.0f) > 0.01f ||
+                std::fabs(up_length - 1.0f) > 0.01f) {
+                std::fprintf(stderr, "invalid exported course sample %u\n", i);
+                return 1;
+            }
+        }
+
+        uint32_t dash_pad_count = 0;
+        if (gdx_rl_export_dash_pads(0, nullptr, &dash_pad_count) != 0 ||
+            dash_pad_count != course_metadata.dash_pad_count || dash_pad_count == 0) {
+            std::fprintf(stderr, "invalid dash-pad count query\n");
+            return 1;
+        }
+        dash_pads.resize(dash_pad_count);
+        uint32_t exported_dash_pad_count = 0;
+        if (gdx_rl_export_dash_pads(dash_pad_count, dash_pads.data(),
+                                    &exported_dash_pad_count) != 0 ||
+            exported_dash_pad_count != dash_pad_count) {
+            return fail("dash-pad export failed");
+        }
+        for (size_t i = 0; i < dash_pads.size(); ++i) {
+            const GdxRlDashPad& pad = dash_pads[i];
+            if (!std::isfinite(pad.entry_distance) || pad.entry_distance < 0.0f ||
+                !(pad.entry_distance < course_metadata.length) || !std::isfinite(pad.target) ||
+                pad.target < -1.0f || pad.target > 1.0f || !std::isfinite(pad.width) ||
+                !(pad.width > 0.0f) || pad.width > 1.0f ||
+                pad.segment_index >= course_metadata.segment_count ||
+                (i > 0 && dash_pads[i - 1].entry_distance > pad.entry_distance)) {
+                std::fprintf(stderr, "invalid exported dash pad %zu\n", i);
+                return 1;
+            }
+        }
+        uint32_t invalid_count = 0;
+        if (gdx_rl_export_dash_pads(0, dash_pads.data(), &invalid_count) == 0 ||
+            gdx_rl_export_dash_pads(1, nullptr, &invalid_count) == 0 ||
+            gdx_rl_export_dash_pads(0, nullptr, nullptr) == 0 ||
+            (dash_pad_count > 1 &&
+             gdx_rl_export_dash_pads(dash_pad_count - 1, dash_pads.data(), &invalid_count) == 0)) {
+            std::fprintf(stderr, "dash-pad export accepted an invalid pointer/capacity combination\n");
+            return 1;
+        }
+
+        if (gdx_rl_export_reference_state(&initial_reference) != 0 ||
+            initial_reference.version != GDX_RL_COURSE_EXPORT_VERSION ||
+            !observation_valid(initial_reference.observation) ||
+            std::memcmp(initial_reference.observation, initial_observation,
+                        sizeof(initial_observation)) != 0) {
+            std::fprintf(stderr, "invalid initial reference-state export\n");
+            return 1;
+        }
+        if (!dash_observation_matches(initial_observation, initial_reference.lap_distance,
+                                      course_metadata, dash_pads)) {
+            std::fprintf(stderr, "initial nearest-dash observation does not match export\n");
+            return 1;
+        }
+    }
+
+    if (observation_oracle) {
+        /* Pure pursuit using only public observations and legal policy actions.
+           This proves the public interface is sufficient to finish without the
+           game's privileged CPU controller or hidden Z/R controls. */
+        constexpr int kSteerValues[GDX_RL_STEER_BINS] = {
+            0, -13, 13, -25, 25, -38, 38, -50, 50, -63, 63,
+        };
+        float observation[GDX_RL_OBSERVATION_SIZE];
+        std::memcpy(observation, initial_observation, sizeof(observation));
+        GdxRlTransition transition = {};
+        float episode_return = 0.0f;
+        uint32_t decisions = 0;
+        uint32_t dash_pad_hits = 0;
+        float previous_next_dash_distance = observation[kNextDashDistance];
+        bool saw_next_dash_wrap = false;
+        while (decisions < 5000 && !transition.terminated && !transition.truncated) {
+            float desired = -63.0f *
+                (0.5f * observation[48] + 0.25f * observation[51] - 0.5f * observation[1]);
+            desired = std::max(-63.0f, std::min(63.0f, desired));
+            int steer_category = 0;
+            float best_error = std::fabs(desired - static_cast<float>(kSteerValues[0]));
+            for (int category = 1; category < GDX_RL_STEER_BINS; ++category) {
+                float error = std::fabs(desired - static_cast<float>(kSteerValues[category]));
+                if (error < best_error) {
+                    best_error = error;
+                    steer_category = category;
+                }
+            }
+            const int32_t action[GDX_RL_ACTION_SIZE] = { steer_category, 0, 1, 0, 0 };
+            if (gdx_rl_step(action, observation, &transition) != 0) {
+                return fail("observation oracle step failed");
+            }
+            if (!observation_valid(observation)) {
+                return 1;
+            }
+            const float lap_distance = wrapped_forward_distance(
+                transition.race_distance, 0.0f, course_metadata.length);
+            if (!dash_observation_matches(observation, lap_distance, course_metadata, dash_pads)) {
+                std::fprintf(stderr, "nearest-dash observation mismatch during oracle drive\n");
+                return 1;
+            }
+            if (observation[kNextDashDistance] > previous_next_dash_distance + 0.001f) {
+                saw_next_dash_wrap = true;
+            }
+            previous_next_dash_distance = observation[kNextDashDistance];
+            if (transition.dash_pad_hits > static_cast<uint8_t>(config.action_repeat)) {
+                std::fprintf(stderr, "impossible dash-pad hit count in one decision\n");
+                return 1;
+            }
+            dash_pad_hits += transition.dash_pad_hits;
+            episode_return += transition.reward;
+            decisions++;
+        }
+        if (!transition.terminated || transition.reason != GDX_RL_FINISHED ||
+            transition.lap != config.laps + 1) {
+            std::fprintf(stderr,
+                         "observation oracle did not finish: reason=%u terminated=%u "
+                         "truncated=%u frame=%u distance=%.3f\n",
+                         transition.reason, transition.terminated, transition.truncated,
+                         transition.episode_frame, transition.race_distance);
+            return 1;
+        }
+        if (!saw_next_dash_wrap) {
+            std::fprintf(stderr, "nearest-dash distance never advanced to a subsequent pad\n");
+            return 1;
+        }
+        std::printf("RL_OBSERVATION_ORACLE_OK decisions=%u physics_frames=%u "
+                    "race_distance=%.3f return=%.6f dash_pad_hits=%u semantic_hash=%016llx\n",
+                    decisions, transition.episode_frame, transition.race_distance, episode_return,
+                    dash_pad_hits,
+                    static_cast<unsigned long long>(transition.semantic_hash));
+        return 0;
+    }
+
+    if (cpu_oracle) {
+        const int32_t neutral_action[GDX_RL_ACTION_SIZE] = { 0, 0, 0, 0, 0 };
+        float observation[GDX_RL_OBSERVATION_SIZE];
+        GdxRlTransition transition = {};
+        uint32_t decisions = 0;
+        const auto start = std::chrono::steady_clock::now();
+        while (decisions < 5000) {
+            if (gdx_rl_step(neutral_action, observation, &transition) != 0) {
+                return fail("CPU oracle step failed");
+            }
+            decisions++;
+            if (!observation_valid(observation)) {
+                return 1;
+            }
+            const float lap_distance = wrapped_forward_distance(
+                transition.race_distance, 0.0f, course_metadata.length);
+            if (!dash_observation_matches(observation, lap_distance, course_metadata, dash_pads)) {
+                std::fprintf(stderr, "nearest-dash observation mismatch during CPU oracle drive\n");
+                return 1;
+            }
+            if (transition.terminated || transition.truncated) {
+                break;
+            }
+        }
+        const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+        if (!transition.terminated || transition.reason != GDX_RL_FINISHED) {
+            std::fprintf(stderr,
+                         "CPU oracle did not finish: reason=%u terminated=%u truncated=%u "
+                         "frame=%u distance=%.3f\n",
+                         transition.reason, transition.terminated, transition.truncated,
+                         transition.episode_frame, transition.race_distance);
+            return 1;
+        }
+        if (transition.lap != config.laps + 1 || transition.race_distance <= 0.0f) {
+            std::fprintf(stderr, "CPU oracle finish telemetry is inconsistent\n");
+            return 1;
+        }
+        std::printf("RL_CPU_ORACLE_OK decisions=%u physics_frames=%u race_distance=%.3f "
+                    "speed=%.3f semantic_hash=%016llx physics_sps=%.1f\n",
+                    decisions, transition.episode_frame, transition.race_distance, transition.speed,
+                    static_cast<unsigned long long>(transition.semantic_hash),
+                    seconds > 0.0 ? transition.episode_frame / seconds : 0.0);
+        return 0;
+    }
+
+    /* Out-of-range categories must fail without advancing the game. */
+    {
+        int32_t invalid_action[GDX_RL_ACTION_SIZE] = { 11, 0, 1, 0, 0 };
+        float scratch_observation[GDX_RL_OBSERVATION_SIZE];
+        GdxRlTransition scratch_transition = {};
+        if (gdx_rl_step(invalid_action, scratch_observation, &scratch_transition) == 0 ||
+            gdx_rl_semantic_hash() != initial_hash) {
+            std::fprintf(stderr, "out-of-range action was accepted or mutated state\n");
+            return 1;
+        }
+    }
+    {
+        const int32_t valid_action[GDX_RL_ACTION_SIZE] = { 0, 0, 1, 0, 0 };
+        GdxRlTransition scratch_transition = {};
+        if (gdx_rl_step(valid_action, nullptr, &scratch_transition) == 0 ||
+            gdx_rl_semantic_hash() != initial_hash) {
+            std::fprintf(stderr, "null observation was accepted or mutated state\n");
+            return 1;
+        }
+    }
+
+    /* Decode every legal categorical endpoint through a real game tick and reset. */
+    for (int head = 0; head < GDX_RL_ACTION_SIZE; ++head) {
+        for (int category = 0; category < gdx_rl_action_nvec[head]; ++category) {
+            float endpoint_initial[GDX_RL_OBSERVATION_SIZE];
+            float endpoint_observation[GDX_RL_OBSERVATION_SIZE];
+            GdxRlTransition endpoint_transition = {};
+            int32_t endpoint_action[GDX_RL_ACTION_SIZE] = { 0, 0, 0, 0, 0 };
+            endpoint_action[head] = category;
+            if (gdx_rl_reset(seed, endpoint_initial) != 0 ||
+                gdx_rl_step(endpoint_action, endpoint_observation, &endpoint_transition) != 0 ||
+                !observation_valid(endpoint_observation)) {
+                return fail("legal action endpoint failed");
+            }
+        }
+    }
+
+    /* The genuine all-zero action must hit the configured no-progress truncation. */
+    {
+        const int32_t neutral_action[GDX_RL_ACTION_SIZE] = { 0, 0, 0, 0, 0 };
+        float noop_initial[GDX_RL_OBSERVATION_SIZE];
+        float noop_observation[GDX_RL_OBSERVATION_SIZE];
+        GdxRlTransition noop_transition = {};
+        if (gdx_rl_reset(seed, noop_initial) != 0) {
+            return fail("no-op reset failed");
+        }
+        for (int decision = 0; decision < 1000 && !noop_transition.terminated && !noop_transition.truncated;
+             ++decision) {
+            if (gdx_rl_step(neutral_action, noop_observation, &noop_transition) != 0) {
+                return fail("no-op step failed");
+            }
+        }
+        if (!noop_transition.truncated || noop_transition.reason != GDX_RL_STALLED ||
+            noop_transition.episode_frame != static_cast<uint32_t>(config.stall_frames)) {
+            std::fprintf(stderr, "no-op did not truncate at the stall boundary\n");
+            return 1;
+        }
+    }
+
+    if (gdx_rl_reset(seed, initial_observation) != 0) {
+        return fail("post-contract reset failed");
+    }
+    std::vector<TraceItem> trace;
+    float maximum_distance = -1.0e30f;
+    for (int decision = 0; decision < 1000; ++decision) {
+        TraceItem item = {};
+        if (gdx_rl_step(throttle_action, item.observation, &item.transition) != 0) {
+            return fail("trace step failed");
+        }
+        if (!observation_valid(item.observation)) {
+            return 1;
+        }
+        const float lap_distance = wrapped_forward_distance(
+            item.transition.race_distance, 0.0f, course_metadata.length);
+        if (!dash_observation_matches(item.observation, lap_distance,
+                                      course_metadata, dash_pads)) {
+            std::fprintf(stderr, "nearest-dash observation mismatch in determinism trace\n");
+            return 1;
+        }
+        maximum_distance = std::max(maximum_distance, item.transition.race_distance);
+        trace.push_back(item);
+        if (item.transition.terminated || item.transition.truncated) {
+            break;
+        }
+    }
+    if (trace.empty() || maximum_distance - trace.front().transition.race_distance < 1000.0f) {
+        std::fprintf(stderr, "held throttle did not produce causal forward progress\n");
+        return 1;
+    }
+    if (!trace.back().transition.terminated && !trace.back().transition.truncated) {
+        std::fprintf(stderr, "trace failed to reach an episode boundary\n");
+        return 1;
+    }
+
+    float replay_initial[GDX_RL_OBSERVATION_SIZE];
+    if (gdx_rl_reset(seed, replay_initial) != 0) {
+        return fail("determinism reset failed");
+    }
+    if (std::memcmp(initial_observation, replay_initial, sizeof(replay_initial)) != 0 ||
+        initial_hash != gdx_rl_semantic_hash()) {
+        std::fprintf(stderr, "same-seed reset did not reproduce the initial semantic state\n");
+        return 1;
+    }
+
+    for (size_t i = 0; i < trace.size(); ++i) {
+        TraceItem replay = {};
+        if (gdx_rl_step(throttle_action, replay.observation, &replay.transition) != 0) {
+            return fail("determinism replay step failed");
+        }
+        if (std::memcmp(trace[i].observation, replay.observation, sizeof(replay.observation)) != 0 ||
+            std::memcmp(&trace[i].transition, &replay.transition, sizeof(replay.transition)) != 0) {
+            std::fprintf(stderr,
+                         "determinism mismatch at decision=%zu expected_hash=%016llx actual_hash=%016llx\n",
+                         i, static_cast<unsigned long long>(trace[i].transition.semantic_hash),
+                         static_cast<unsigned long long>(replay.transition.semantic_hash));
+            return 1;
+        }
+    }
+
+    const GdxRlTransition& final = trace.back().transition;
+    std::printf("RL_ENV_DETERMINISM_OK decisions=%zu physics_frames=%u max_distance=%.3f "
+                "end_reason=%u final_hash=%016llx\n",
+                trace.size(), final.episode_frame, maximum_distance, final.reason,
+                static_cast<unsigned long long>(final.semantic_hash));
+    return 0;
+}
diff --git a/port/rl/gdx_rl_thread_test.cpp b/port/rl/gdx_rl_thread_test.cpp
new file mode 100644
index 0000000..2801750
--- /dev/null
+++ b/port/rl/gdx_rl_thread_test.cpp
@@ -0,0 +1,78 @@
+#include "gdx_rl_env.h"
+
+#include <cstdio>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+namespace {
+
+struct TraceItem {
+    float observation[GDX_RL_OBSERVATION_SIZE];
+    GdxRlTransition transition;
+};
+
+} // namespace
+
+int main(int argc, char** argv) {
+    if (argc != 2) {
+        std::fprintf(stderr, "usage: %s <baserom.us.rev0.z64>\n", argv[0]);
+        return 2;
+    }
+    GdxRlConfig config;
+    gdx_rl_default_config(&config);
+    config.laps = 1;
+    if (gdx_rl_init(argv[1], &config) != 0) {
+        std::fprintf(stderr, "init failed: %s\n", gdx_rl_last_error());
+        return 1;
+    }
+
+    constexpr uint32_t seed = 0x71EAD123u;
+    float initial[GDX_RL_OBSERVATION_SIZE];
+    if (gdx_rl_reset(seed, initial) != 0) {
+        std::fprintf(stderr, "initial reset failed: %s\n", gdx_rl_last_error());
+        return 1;
+    }
+
+    std::vector<TraceItem> worker_trace(64);
+    int worker_result = 0;
+    std::thread worker([&]() {
+        if (gdx_rl_bind_thread() != 0) {
+            worker_result = 1;
+            return;
+        }
+        const int32_t action[GDX_RL_ACTION_SIZE] = { 0, 0, 1, 0, 0 };
+        for (TraceItem& item : worker_trace) {
+            if (gdx_rl_step(action, item.observation, &item.transition) != 0) {
+                worker_result = 2;
+                return;
+            }
+        }
+    });
+    worker.join();
+    if (worker_result != 0) {
+        std::fprintf(stderr, "worker-thread rollout failed (%d): %s\n", worker_result, gdx_rl_last_error());
+        return 1;
+    }
+
+    if (gdx_rl_bind_thread() != 0 || gdx_rl_reset(seed, initial) != 0) {
+        std::fprintf(stderr, "main-thread rebound/reset failed: %s\n", gdx_rl_last_error());
+        return 1;
+    }
+    const int32_t action[GDX_RL_ACTION_SIZE] = { 0, 0, 1, 0, 0 };
+    for (size_t i = 0; i < worker_trace.size(); ++i) {
+        TraceItem replay = {};
+        if (gdx_rl_step(action, replay.observation, &replay.transition) != 0) {
+            std::fprintf(stderr, "main-thread replay failed: %s\n", gdx_rl_last_error());
+            return 1;
+        }
+        if (std::memcmp(worker_trace[i].observation, replay.observation, sizeof(replay.observation)) != 0 ||
+            std::memcmp(&worker_trace[i].transition, &replay.transition, sizeof(replay.transition)) != 0) {
+            std::fprintf(stderr, "thread migration changed state at decision %zu\n", i);
+            return 1;
+        }
+    }
+    std::printf("RL_THREAD_REBIND_OK decisions=%zu semantic_hash=%016llx\n", worker_trace.size(),
+                static_cast<unsigned long long>(worker_trace.back().transition.semantic_hash));
+    return 0;
+}
