index 5b40125..33f639f 100644
--- a/port/rom_buffer.cpp
+++ b/port/rom_buffer.cpp
@@ -29,6 +29,121 @@ char     gdx_rom_path[1024] = {};
    candidate was turned away for being Japanese, purely so the fatal dialog can say so. */
 static bool s_refusedJapaneseRom = false;
 
+/* Vendored public-domain SHA-1 (Steve Reid reference, condensed). ROM identity only: SHA-1 is
+   the key used by the decomp recipes, not a security primitive. */
+typedef struct GdxRomSha1 {
+    uint32_t state[5];
+    uint64_t bitCount;
+    uint8_t buffer[64];
+} GdxRomSha1;
+
+static uint32_t gdx_rom_rol32(uint32_t value, int bits) {
+    return (value << bits) | (value >> (32 - bits));
+}
+
+static void gdx_rom_sha1_transform(uint32_t state[5], const uint8_t buffer[64]) {
+    uint32_t words[80];
+    for (int i = 0; i < 16; ++i) {
+        words[i] = ((uint32_t) buffer[i * 4] << 24) | ((uint32_t) buffer[i * 4 + 1] << 16) |
+                   ((uint32_t) buffer[i * 4 + 2] << 8) | (uint32_t) buffer[i * 4 + 3];
+    }
+    for (int i = 16; i < 80; ++i) {
+        words[i] = gdx_rom_rol32(words[i - 3] ^ words[i - 8] ^ words[i - 14] ^ words[i - 16], 1);
+    }
+
+    uint32_t a = state[0];
+    uint32_t b = state[1];
+    uint32_t c = state[2];
+    uint32_t d = state[3];
+    uint32_t e = state[4];
+    for (int i = 0; i < 80; ++i) {
+        uint32_t f;
+        uint32_t k;
+        if (i < 20) {
+            f = (b & c) | ((~b) & d);
+            k = 0x5A827999u;
+        } else if (i < 40) {
+            f = b ^ c ^ d;
+            k = 0x6ED9EBA1u;
+        } else if (i < 60) {
+            f = (b & c) | (b & d) | (c & d);
+            k = 0x8F1BBCDCu;
+        } else {
+            f = b ^ c ^ d;
+            k = 0xCA62C1D6u;
+        }
+        uint32_t next = gdx_rom_rol32(a, 5) + f + e + k + words[i];
+        e = d;
+        d = c;
+        c = gdx_rom_rol32(b, 30);
+        b = a;
+        a = next;
+    }
+    state[0] += a;
+    state[1] += b;
+    state[2] += c;
+    state[3] += d;
+    state[4] += e;
+}
+
+static void gdx_rom_sha1_init(GdxRomSha1* context) {
+    context->state[0] = 0x67452301u;
+    context->state[1] = 0xEFCDAB89u;
+    context->state[2] = 0x98BADCFEu;
+    context->state[3] = 0x10325476u;
+    context->state[4] = 0xC3D2E1F0u;
+    context->bitCount = 0;
+}
+
+static void gdx_rom_sha1_update(GdxRomSha1* context, const uint8_t* data, size_t size) {
+    size_t index = (size_t) ((context->bitCount >> 3) & 63u);
+    context->bitCount += (uint64_t) size << 3;
+    size_t part = 64 - index;
+    size_t offset = 0;
+    if (size >= part) {
+        memcpy(&context->buffer[index], data, part);
+        gdx_rom_sha1_transform(context->state, context->buffer);
+        for (offset = part; offset + 63 < size; offset += 64) {
+            gdx_rom_sha1_transform(context->state, &data[offset]);
+        }
+        index = 0;
+    }
+    memcpy(&context->buffer[index], &data[offset], size - offset);
+}
+
+static void gdx_rom_sha1_final(GdxRomSha1* context, uint8_t digest[20]) {
+    uint8_t finalCount[8];
+    for (int i = 0; i < 8; ++i) {
+        finalCount[i] = (uint8_t) ((context->bitCount >> ((7 - i) * 8)) & 0xFFu);
+    }
+    uint8_t padding = 0x80;
+    gdx_rom_sha1_update(context, &padding, 1);
+    padding = 0;
+    while ((context->bitCount & 504u) != 448u) {
+        gdx_rom_sha1_update(context, &padding, 1);
+    }
+    gdx_rom_sha1_update(context, finalCount, sizeof(finalCount));
+    for (int i = 0; i < 20; ++i) {
+        digest[i] = (uint8_t) ((context->state[i >> 2] >> ((3 - (i & 3)) * 8)) & 0xFFu);
+    }
+}
+
+static bool gdx_rom_is_us_rev0(const uint8_t* data, size_t size) {
+    static const uint8_t expectedSha1[20] = {
+        0x5F, 0x65, 0x8E, 0x88, 0xFF, 0xA9, 0xDE, 0x23, 0xCB, 0xA6,
+        0x98, 0x6A, 0x8F, 0xD3, 0xD3, 0xA9, 0x0D, 0x7B, 0x43, 0x40,
+    };
+    uint8_t actualSha1[20];
+    GdxRomSha1 context;
+    if (data == nullptr || size != 16u * 1024u * 1024u) {
+        return false;
+    }
+    gdx_rom_sha1_init(&context);
+    gdx_rom_sha1_update(&context, data, size);
+    gdx_rom_sha1_final(&context, actualSha1);
+    return memcmp(actualSha1, expectedSha1, sizeof(expectedSha1)) == 0;
+}
+
