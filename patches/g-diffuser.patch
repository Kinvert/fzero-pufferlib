+extern "C" int gdx_rl_init(const char* rom_path, const GdxRlConfig* config) {
+    sLastError[0] = '\0';
+    if (sInitialized) {
+        set_error("this F-Zero module namespace is already initialized");
+        return -1;
+    }
+    if (rom_path == nullptr || rom_path[0] == '\0') {
+        set_error("rom_path is empty");
+        return -1;
+    }
+
+    GdxRlConfig selected;
+    gdx_rl_default_config(&selected);
+    if (config != nullptr) {
+        selected = *config;
+    }
+    if (!validate_config(selected)) {
+        return -1;
+    }
+    sConfig = selected;
+    sOwnerThread = std::this_thread::get_id();
+
+    if (gdx_load_rom_explicit_us_rev0(rom_path) != 0) {
+        set_error("failed to load the explicit US rev0 ROM (expected 16 MiB SHA-1 "
+                  "5f658e88ffa9de23cba6986a8fd3d3a90d7b4340)");
+        return -1;
+    }
+
+    /* Generic developer gates deliberately remain zero-initialized. Inherited process
+       environment is not seeded episode state and must not alter the training runtime. */
+    gdx_headless_clock_reset(0);
+    gdx_headless_prepare_cartridge_boot();
+    gdx_headless_clear_pad();
+    gdx_headless_set_game_thread_reset_hook(game_thread_reset);
+    gdx_sched_init();
+
+    gdx_rdram_init();
+    gdx_register_host_range(gdx_rom_buffer, gdx_rom_size);
+    gdx_register_main_module_range();
+    GDiffuser_LoadAllAssets();
+    bootproc();
+
+    bool queued = false;
+    for (int vi = 0; vi < 4096; ++vi) {
+        if (!queued && gGameFrameCount > 0 && GET_MODE(gGameMode) == GAMEMODE_TITLE &&
+            gGameModeChangeState == GAMEMODE_UPDATE) {
+            configure_time_attack();
+            gQueuedGameMode = GAMEMODE_TIME_ATTACK;
+            queued = true;
+        }
+        gdx_headless_clear_pad();
+        tick_once();
+        if (queued && GET_MODE(gGameMode) == GAMEMODE_TIME_ATTACK &&
+            gGameModeChangeState == GAMEMODE_UPDATE && gTotalRacers == 1 &&
+            gCurrentCourseInfo != nullptr && (gRacers[0].stateFlags & RACER_STATE_ACTIVE) != 0 &&
+            gRaceIntroTimer > 40) {
+            if (!build_dash_pad_cache()) {
+                return -1;
+            }
+            sInitialized = true;
+            return 0;
+        }
+    }
+
+    set_error("timed out while booting the selected Time Attack race");
+    return -1;
+}
+
+extern "C" int gdx_rl_bind_thread(void) {
+    if (!sInitialized) {
+        set_error("cannot bind thread before F-Zero RL initialization");
+        return -1;
+    }
+    if (sResetPending) {
+        set_error("cannot bind thread while a reset request is pending");
+        return -1;
+    }
+    if (gdx_sched_rebind_current_thread() != 0) {
+        set_error("fiber backend cannot migrate this environment to the current OS thread");
+        return -1;
+    }
+    sOwnerThread = std::this_thread::get_id();
+    return 0;
+}
