+/*
+ * Deterministic cartridge-only host services for the RL runtime.
+ *
+ * This file deliberately owns no game policy. It supplies the platform surface the decomp
+ * expects while keeping every effect process-local: virtual time, an injected N64 pad, in-memory
+ * SRAM, synchronous raw-ROM DMA, and renderer/audio-device sinks. Game logic and CPU display-list
+ * construction still run unchanged; only submission is discarded after a small diagnostic hash.
+ */
+
+#ifndef _LANGUAGE_C
+#define _LANGUAGE_C 1
+#endif
+
