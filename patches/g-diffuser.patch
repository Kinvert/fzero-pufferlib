+extern "C" int gdx_rl_reset(uint32_t seed, float observation[GDX_RL_OBSERVATION_SIZE]) {
+    if (!on_owner_thread()) {
+        return -1;
+    }
+    if (observation == nullptr) {
+        set_error("observation pointer is null");
+        return -1;
+    }
+    if (GET_MODE(gGameMode) != GAMEMODE_TIME_ATTACK || gGameModeChangeState != GAMEMODE_UPDATE) {
+        set_error("reset requested outside a settled Time Attack race");
+        return -1;
+    }
+
+    sEpisodeReady = false;
+    gdx_headless_clear_pad();
+    sResetSeed = seed;
+    sResetConsumed = false;
+    sResetPending = true;
+    for (int vi = 0; vi < 64 && !sResetConsumed; ++vi) {
+        tick_once();
+    }
+    if (!sResetConsumed || gRaceIntroTimer != 41) {
+        set_error("game-thread race reset did not complete");
+        return -1;
+    }
+
+    /* Run exactly the stock 41 -> 40 edge so the game's own code enables controls. */
+    tick_once();
+    if (gRaceIntroTimer != 40 || (gRacers[0].stateFlags & RACER_STATE_FLAGS_400000) == 0) {
+        set_error("canonical race control-arm edge did not fire");
+        return -1;
+    }
+    gRaceIntroTimer = 0;
+    gEnableRaceSfx = 0;
+    if (sConfig.cpu_oracle != 0) {
+        gRacers[0].stateFlags |= RACER_STATE_CPU_CONTROLLED;
+    }
+    if (!build_dash_pad_cache()) {
+        return -1;
+    }
+
+    sEpisodeDone = false;
+    sDamageDuringDecision = false;
+    sOnDashPad =
+        (gRacers[0].stateFlags & COURSE_EFFECT_MASK) == COURSE_EFFECT_DASH;
+    sEpisodeFrame = 0;
+    sFramesWithoutProgress = 0;
+    sPreviousDistance = gRacers[0].raceDistance;
+    sBestDistance = sPreviousDistance;
+    sProgressCheckpoint = sPreviousDistance;
+    sPreviousLapsCompleted = gRacers[0].lapsCompleted;
+    const int32_t neutral[GDX_RL_ACTION_SIZE] = { 0, 0, 0, 0, 0 };
+    std::memcpy(sPreviousAction, neutral, sizeof(sPreviousAction));
+    if (!observe(observation)) {
+        return -1;
+    }
+    sEpisodeReady = true;
+    return 0;
+}
+
+extern "C" int gdx_rl_step(const int32_t action[GDX_RL_ACTION_SIZE],
+                             float observation[GDX_RL_OBSERVATION_SIZE], GdxRlTransition* transition) {
+    if (!on_owner_thread()) {
+        return -1;
+    }
+    if (action == nullptr || observation == nullptr || transition == nullptr) {
+        set_error("action, observation, or transition pointer is null");
+        return -1;
+    }
+    if (!sEpisodeReady) {
+        set_error("step called before a successful episode reset");
+        return -1;
+    }
+    if (sEpisodeDone) {
+        set_error("step called after episode end; reset first");
+        return -1;
+    }
+    for (int i = 0; i < GDX_RL_ACTION_SIZE; ++i) {
+        if (action[i] < 0 || action[i] >= gdx_rl_action_nvec[i]) {
+            set_errorf("action category is out of range at index %d", i);
+            return -1;
+        }
+    }
+
+    std::memset(transition, 0, sizeof(*transition));
+    std::memcpy(sPreviousAction, action, sizeof(sPreviousAction));
+    sDamageDuringDecision = false;
+    float reward = 0.0f;
+    GdxRlTerminationReason reason = GDX_RL_RUNNING;
+
+    for (int repeat = 0; repeat < sConfig.action_repeat; ++repeat) {
+        unsigned short buttons = 0;
+        if (action[2] != 0) {
+            buttons |= BTN_A;
+        }
+        if (action[3] != 0) {
+            buttons |= BTN_CDOWN;
+        }
+        if (action[4] != 0 && repeat == 0) {
+            buttons |= BTN_B;
+        }
+        gdx_headless_set_pad(buttons, static_cast<signed char>(kSteerValues[action[0]]),
+                             static_cast<signed char>(kPitchValues[action[1]]));
+        tick_once();
+        sEpisodeFrame++;
+
+        const Racer& racer = gRacers[0];
+        const bool on_dash_pad =
+            (racer.stateFlags & COURSE_EFFECT_MASK) == COURSE_EFFECT_DASH;
+        if (on_dash_pad && !sOnDashPad) {
+            transition->dash_pad_hits++;
+        }
+        sOnDashPad = on_dash_pad;
+        sDamageDuringDecision = sDamageDuringDecision ||
+                                (racer.stateFlags & RACER_STATE_RECEIVED_DAMAGE) != 0;
+        reward += (racer.raceDistance - sPreviousDistance) / 1000.0f;
+        sPreviousDistance = racer.raceDistance;
+        if (racer.lapsCompleted > sPreviousLapsCompleted) {
+            reward += 2.0f * static_cast<float>(racer.lapsCompleted - sPreviousLapsCompleted);
+        }
+        sPreviousLapsCompleted = racer.lapsCompleted;
+
+        sBestDistance = std::max(sBestDistance, racer.raceDistance);
+        if (sBestDistance >= sProgressCheckpoint + sConfig.stall_progress) {
+            sProgressCheckpoint = sBestDistance;
+            sFramesWithoutProgress = 0;
+        } else {
+            sFramesWithoutProgress++;
+        }
+
+        reason = failure_reason(racer.stateFlags);
+        if (reason != GDX_RL_RUNNING) {
+            transition->terminated = 1;
+            reward += reason == GDX_RL_FINISHED ? 25.0f : -25.0f;
+            break;
+        }
+        if (sEpisodeFrame >= static_cast<uint32_t>(sConfig.max_episode_frames)) {
+            reason = GDX_RL_TIME_LIMIT;
+            transition->truncated = 1;
+            break;
+        }
+        if (sConfig.stall_frames > 0 &&
+            sFramesWithoutProgress >= static_cast<uint32_t>(sConfig.stall_frames)) {
+            reason = GDX_RL_STALLED;
+            transition->truncated = 1;
+            break;
+        }
+    }
+
+    sEpisodeDone = transition->terminated != 0 || transition->truncated != 0;
+    if (!observe(observation)) {
+        return -1;
+    }
+    const Racer& racer = gRacers[0];
+    transition->reward = reward;
+    transition->race_distance = racer.raceDistance;
+    transition->speed = racer.speed;
+    transition->energy_fraction = encode_energy_fraction(racer.energy, racer.maxEnergy);
+    transition->semantic_hash = semantic_hash_impl();
+    transition->episode_frame = sEpisodeFrame;
+    transition->lap = racer.lap;
+    transition->reason = static_cast<uint8_t>(reason);
+    return 0;
+}
+
+extern "C" int gdx_rl_export_course(uint32_t sample_count, GdxRlCourseSample* samples,
+                                      GdxRlCourseMetadata* metadata) {
+    if (!on_owner_thread()) {
+        return -1;
+    }
+    if (samples == nullptr || metadata == nullptr) {
+        set_error("course samples or metadata pointer is null");
+        return -1;
+    }
+    if (sample_count < 2 || sample_count > 65536) {
+        set_error("course sample_count must be in [2, 65536]");
+        return -1;
+    }
+    if (gCurrentCourseInfo == nullptr || gCurrentCourseInfo->courseSegments == nullptr ||
+        gCurrentCourseInfo->segmentCount <= 0 || !(gCurrentCourseInfo->length > 0.0f)) {
+        set_error("course export requested before course initialization");
+        return -1;
+    }
+
+    const float spacing = gCurrentCourseInfo->length / static_cast<float>(sample_count);
+    for (uint32_t i = 0; i < sample_count; ++i) {
+        const float distance = spacing * static_cast<float>(i);
+        float t = 0.0f;
+        float length_proportion = 0.0f;
+        CourseSegment* segment = segment_at_distance(distance, &t, &length_proportion);
+        if (segment == nullptr) {
+            set_error("failed to resolve course sample segment");
+            return -1;
+        }
+
+        Vec3f position;
+        Mtx3F basis;
+        Course_SplineGetPosition(segment, t, &position);
+        Course_SplineGetBasis(segment, t, &basis, length_proportion);
+
+        GdxRlCourseSample& sample = samples[i];
+        std::memset(&sample, 0, sizeof(sample));
+        sample.distance = distance;
+        sample.position[0] = position.x;
+        sample.position[1] = position.y;
+        sample.position[2] = position.z;
+        sample.forward[0] = basis.x.x;
+        sample.forward[1] = basis.x.y;
+        sample.forward[2] = basis.x.z;
+        sample.up[0] = basis.y.x;
+        sample.up[1] = basis.y.y;
+        sample.up[2] = basis.y.z;
+        sample.side[0] = basis.z.x;
+        sample.side[1] = basis.z.y;
+        sample.side[2] = basis.z.z;
+        sample.radius_left = segment->radiusLeft +
+                             (segment->next->radiusLeft - segment->radiusLeft) * length_proportion;
+        sample.radius_right = segment->radiusRight +
+                              (segment->next->radiusRight - segment->radiusRight) * length_proportion;
+        sample.track_segment_info = static_cast<uint32_t>(segment->trackSegmentInfo);
+        sample.segment_index = segment->segmentIndex;
+    }
+
+    std::memset(metadata, 0, sizeof(*metadata));
+    metadata->version = GDX_RL_COURSE_EXPORT_VERSION;
+    metadata->sample_count = sample_count;
+    metadata->segment_count = static_cast<uint32_t>(gCurrentCourseInfo->segmentCount);
+    metadata->dash_pad_count = sDashPadCount;
+    metadata->length = gCurrentCourseInfo->length;
+    metadata->sample_spacing = spacing;
+    return 0;
+}
