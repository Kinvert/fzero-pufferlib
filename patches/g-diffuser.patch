diff --git a/port/gdx_render_eval.c b/port/gdx_render_eval.c
new file mode 100644
index 0000000..c94d66c
--- /dev/null
+++ b/port/gdx_render_eval.c
@@ -0,0 +1,235 @@
+// G-Diffuser — graphical host bridge for deterministic Puffer policy replays.
+
+#include "gdx_render_eval.h"
+
+#ifndef _LANGUAGE_C
+#define _LANGUAGE_C 1
+#endif
+#include "PR/os_pfs.h" // decomp scalar/vector types for the game headers below
+#include "fzx_course.h"
+#include "fzx_game.h"
+#include "fzx_racer.h"
+#include "fzx_save.h"
+
+// This TU intentionally stays on the decomp-header side of the libc boundary: mixing the host
+// CRT headers pulled by port_log.h with libultra's 32-bit intptr_t/bcopy declarations is invalid.
+// n64_sched.c owns this always-on printf sink and formats on the host side for us.
+extern void gdx_dbg_logf(const char* fmt, ...);
+extern char* getenv(const char* name);
+
+enum GdxRenderEvalPhase {
+    GDX_RENDER_EVAL_DISABLED = 0,
+    GDX_RENDER_EVAL_WAIT_TITLE,
+    GDX_RENDER_EVAL_WAIT_RACE,
+    GDX_RENDER_EVAL_RESET_PENDING,
+    GDX_RENDER_EVAL_WAIT_CONTROL_EDGE,
+    GDX_RENDER_EVAL_READY,
+    GDX_RENDER_EVAL_TERMINAL,
+};
+
+enum {
+    GDX_RENDER_EVAL_SEED = 73,
+    GDX_RENDER_EVAL_DEFAULT_COURSE = 0,
+    GDX_RENDER_EVAL_MAX_STOCK_COURSE = 23,
+    GDX_RENDER_EVAL_CHARACTER = 0,
+    GDX_RENDER_EVAL_MACHINE_SKIN = 0,
+    GDX_RENDER_EVAL_LAPS = 1,
+};
+
+static int sGateRead;
+static int sActive;
+static int sCourseIndex = GDX_RENDER_EVAL_DEFAULT_COURSE;
+static int sReady;
+static int sResetPending;
+static u32 sEpisodeFrame;
+static enum GdxRenderEvalPhase sPhase = GDX_RENDER_EVAL_DISABLED;
+
+void Math_Rand1Init(s32 seed, s32 mask);
+void Math_Rand2Init(s32 seed, s32 mask);
+void func_i2_80103A70(void);
+
+extern s32 gCourseIndex;
+extern s32 gCurrentGhostType;
+extern char* gCurrentTrackName;
+extern CourseInfo* gCurrentCourseInfo;
+extern s16 gEnableRaceSfx;
+extern u32 gGameFrameCount;
+extern s32 gGameMode;
+extern s16 gGameModeChangeState;
+extern s32 gNumPlayers;
+extern f32 gPlayerEngine[4];
+extern s16 gPlayerCharacters[4];
+extern s16 gPlayerMachineSkins[4];
+extern s32 gQueuedGameMode;
+extern s32 gRaceIntroTimer;
+extern s32 gSelectedMode;
+extern s8 gTitleDemoState;
+extern s32 gTotalLapCount;
+extern s32 gTotalRacers;
+extern char* gTrackNames[55];
+
+static int gdx_render_eval_parse_course(const char* text, int* outCourse) {
+    int value = 0;
+    const char* cursor = text;
+
+    if (cursor == NULL || *cursor == '\0') {
+        return 0;
+    }
+    while (*cursor != '\0') {
+        if (*cursor < '0' || *cursor > '9') {
+            return 0;
+        }
+        value = value * 10 + (*cursor - '0');
+        if (value > GDX_RENDER_EVAL_MAX_STOCK_COURSE) {
+            return 0;
+        }
+        cursor++;
+    }
+    *outCourse = value;
+    return 1;
+}
+
+static void gdx_render_eval_configure_time_attack(void) {
+    gNumPlayers = 1;
+    gCourseIndex = sCourseIndex;
+    gTotalLapCount = GDX_RENDER_EVAL_LAPS;
+    gPlayerCharacters[0] = GDX_RENDER_EVAL_CHARACTER;
+    gPlayerMachineSkins[0] = GDX_RENDER_EVAL_MACHINE_SKIN;
+    gPlayerEngine[0] = 0.5f;
+    gCurrentGhostType = GHOST_NONE;
+    gTitleDemoState = TITLE_DEMO_INACTIVE;
+    gSelectedMode = MODE_TIME_ATTACK;
+    gCurrentTrackName = gTrackNames[gCourseIndex];
+}
+
+static const char* gdx_render_eval_terminal_reason(u32 stateFlags) {
+    if ((stateFlags & RACER_STATE_FINISHED) != 0) {
+        return "finished";
+    }
+    if ((stateFlags & RACER_STATE_SPINNING_OUT) != 0) {
+        return "spinning-out";
+    }
+    if ((stateFlags & RACER_STATE_FALLING_OFF_TRACK) != 0) {
+        return "fell-off-track";
+    }
+    if ((stateFlags & RACER_STATE_CRASHED) != 0) {
+        return "crashed";
+    }
+    if ((stateFlags & RACER_STATE_RETIRED) != 0) {
+        return "retired";
+    }
+    return NULL;
+}
+
+int gdx_render_eval_active(void) {
+    if (!sGateRead) {
+        const char* gate = getenv("GDX_RL_RENDER_EVAL");
+        const char* course = getenv("GDX_RL_COURSE_INDEX");
+        sGateRead = 1;
+        sActive = gate != NULL && gate[0] == '1' && gate[1] == '\0';
+        if (sActive && course != NULL && !gdx_render_eval_parse_course(course, &sCourseIndex)) {
+            gdx_dbg_logf(
+                "[render-eval] invalid GDX_RL_COURSE_INDEX=%s (expected stock course 0..23); "
+                "render eval disabled\n",
+                course);
+            sActive = 0;
+        }
+        sPhase = sActive ? GDX_RENDER_EVAL_WAIT_TITLE : GDX_RENDER_EVAL_DISABLED;
+        if (sActive) {
+            gdx_dbg_logf(
+                "[render-eval] enabled: seed=73 course=%d character=0 skin=0 engine=0.5 "
+                "ghost=none laps=1 mode=time-attack; interpolation disabled; pacing forced "
+                "to ~59.94 Hz\n",
+                sCourseIndex);
+        }
+    }
+    return sActive;
+}
+
+int gdx_render_eval_ready(void) {
+    (void) gdx_render_eval_active();
+    return sReady;
+}
+
+void gdx_render_eval_host_tick(void) {
+    if (!gdx_render_eval_active()) {
+        return;
+    }
+
+    if (sPhase == GDX_RENDER_EVAL_WAIT_TITLE) {
+        if (gGameFrameCount > 0 && GET_MODE(gGameMode) == GAMEMODE_TITLE &&
+            gGameModeChangeState == GAMEMODE_UPDATE) {
+            gdx_render_eval_configure_time_attack();
+            gQueuedGameMode = GAMEMODE_TIME_ATTACK;
+            sPhase = GDX_RENDER_EVAL_WAIT_RACE;
+            gdx_dbg_logf("[render-eval] canonical Time Attack queued from settled title mode\n");
+        }
+        return;
+    }
+
+    if (sPhase == GDX_RENDER_EVAL_WAIT_RACE) {
+        if (GET_MODE(gGameMode) == GAMEMODE_TIME_ATTACK &&
+            gGameModeChangeState == GAMEMODE_UPDATE && gTotalRacers == 1 &&
+            gCurrentCourseInfo != NULL && (gRacers[0].stateFlags & RACER_STATE_ACTIVE) != 0 &&
+            gRaceIntroTimer > 40) {
+            sResetPending = 1;
+            sPhase = GDX_RENDER_EVAL_RESET_PENDING;
+            gdx_dbg_logf("[render-eval] race settled; canonical game-fiber reset requested\n");
+        }
+        return;
+    }
+
+    if (sPhase == GDX_RENDER_EVAL_WAIT_CONTROL_EDGE && gRaceIntroTimer == 40 &&
+        (gRacers[0].stateFlags & RACER_STATE_FLAGS_400000) != 0) {
+        // Match gdx_rl_reset exactly: retain the game's own control-arm update, then remove the
+        // rest of the countdown before exposing the first policy action.
+        gRaceIntroTimer = 0;
+        gEnableRaceSfx = 0;
+        sReady = 1;
+        sEpisodeFrame = 0;
+        sPhase = GDX_RENDER_EVAL_READY;
+        gdx_dbg_logf(
+            "[render-eval] START/ARMED: canonical 41->40 control edge complete; policy frame 0\n");
+        return;
+    }
+
+    if (sPhase == GDX_RENDER_EVAL_READY) {
+        const u32 stateFlags = (u32) gRacers[0].stateFlags;
+        const char* reason;
+
+        // This host sample is immediately after one graphical game tick and before the next input
+        // poll, so it counts the same per-tick boundary as the headless evaluator.
+        sEpisodeFrame++;
+        reason = gdx_render_eval_terminal_reason(stateFlags);
+        if (reason != NULL) {
+            sPhase = GDX_RENDER_EVAL_TERMINAL;
+            gdx_dbg_logf(
+                "[render-eval] %s: reason=%s episode_frame=%u game_frame=%u flags=0x%08X "
+                "lap=%d laps_completed=%d race_distance=%.3f race_time=%d\n",
+                (stateFlags & RACER_STATE_FINISHED) != 0 ? "FINISH" : "TERMINAL",
+                reason, (unsigned) sEpisodeFrame, (unsigned) gGameFrameCount,
+                (unsigned) stateFlags, (int) gRacers[0].lap, (int) gRacers[0].lapsCompleted,
+                (double) gRacers[0].raceDistance, (int) gRacers[0].raceTime);
+        }
+    }
+}
+
+// Called only by Race_Update, on the cooperative game fiber. The reset routines use blocking N64
+// queues and must never be invoked directly by the graphical host loop.
+int gdx_rl_game_thread_reset(void) {
+    if (!gdx_render_eval_active() || !sResetPending) {
+        return 0;
+    }
+
+    sResetPending = 0;
+    gdx_render_eval_configure_time_attack();
+    gGameFrameCount = 0;
+    Math_Rand1Init(GDX_RENDER_EVAL_SEED, GDX_RENDER_EVAL_SEED + GDX_RENDER_EVAL_SEED);
+    Math_Rand2Init(GDX_RENDER_EVAL_SEED + GDX_RENDER_EVAL_SEED, GDX_RENDER_EVAL_SEED);
+    func_i2_80103A70();
+    gRaceIntroTimer = 41;
+    gEnableRaceSfx = 0;
+    sPhase = GDX_RENDER_EVAL_WAIT_CONTROL_EDGE;
+    gdx_dbg_logf("[render-eval] game-fiber reset complete at intro timer 41\n");
+    return 1;
+}
diff --git a/port/gdx_render_eval.h b/port/gdx_render_eval.h
new file mode 100644
index 0000000..f7d9d9d
--- /dev/null
+++ b/port/gdx_render_eval.h
@@ -0,0 +1,25 @@
+// G-Diffuser — opt-in rendered replay of a deterministic headless RL race.
+//
+// The feature is inert unless GDX_RL_RENDER_EVAL=1 is present at process start. The host-side
+// tick queues the same one-lap Time Attack setup used by gdx_rl_env.cpp, while Race_Update calls
+// the reset hook on the cooperative game fiber. Mute City (course 0) is the default;
+// GDX_RL_COURSE_INDEX can select another stock course 0..23. Input playback remains paused until
+// gdx_render_eval_ready() reports the stock 41 -> 40 control-arm edge has completed.
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Cache and report the process-start environment gate. Once read, the value does not change.
+int gdx_render_eval_active(void);
+
+// True only after the canonical game-fiber reset and stock control-arm edge have completed.
+int gdx_render_eval_ready(void);
+
+// Called once per graphical host frame before controller polling.
+void gdx_render_eval_host_tick(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/port/gdx_video_capture.cpp b/port/gdx_video_capture.cpp
new file mode 100644
index 0000000..b49df99
--- /dev/null
+++ b/port/gdx_video_capture.cpp
@@ -0,0 +1,168 @@
+#include "gdx_video_capture.h"
+
+#include "port_log.h"
+
+#include <SDL2/SDL.h>
+#define GL_GLEXT_PROTOTYPES 1
+#include <SDL2/SDL_opengles2.h>
+
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+namespace {
+
+struct CaptureState {
+    bool initialized = false;
+    bool active = false;
+    bool finished = false;
+    FILE* stream = nullptr;
+    uint64_t frame = 0;
+    uint64_t maxFrames = 0;
+    int width = 0;
+    int height = 0;
+    std::vector<uint8_t> rgba;
+};
+
+CaptureState sCapture;
+
+void finishCapture(const char* reason) {
+    if (sCapture.stream != nullptr) {
+        if (std::fclose(sCapture.stream) != 0) {
+            gdx_port_logf("[video-capture] close FAILED: %s\n", std::strerror(errno));
+        }
+        sCapture.stream = nullptr;
+    }
+    if (!sCapture.finished && reason != nullptr) {
+        gdx_port_logf("[video-capture] %s after %llu frame(s)\n", reason,
+                      static_cast<unsigned long long>(sCapture.frame));
+    }
+    sCapture.finished = true;
+}
+
+bool initializeCapture() {
+    sCapture.initialized = true;
+
+    const char* path = std::getenv("GDX_VIDEO_CAPTURE_RAW");
+    if (path == nullptr || path[0] == '\0') {
+        sCapture.finished = true;
+        return false;
+    }
+    sCapture.active = true;
+
+    const char* frameLimit = std::getenv("GDX_VIDEO_CAPTURE_FRAMES");
+    if (frameLimit != nullptr && frameLimit[0] != '\0') {
+        char* end = nullptr;
+        errno = 0;
+        const unsigned long long parsed = std::strtoull(frameLimit, &end, 10);
+        if (errno != 0 || end == frameLimit || *end != '\0' || parsed == 0) {
+            gdx_port_logf("[video-capture] invalid GDX_VIDEO_CAPTURE_FRAMES=%s\n", frameLimit);
+            sCapture.finished = true;
+            return false;
+        }
+        sCapture.maxFrames = static_cast<uint64_t>(parsed);
+    }
+
+    SDL_Window* window = SDL_GL_GetCurrentWindow();
+    if (window == nullptr) {
+        gdx_port_logf("[video-capture] no current SDL OpenGL window\n");
+        sCapture.finished = true;
+        return false;
+    }
+    SDL_GL_GetDrawableSize(window, &sCapture.width, &sCapture.height);
+    if (sCapture.width <= 0 || sCapture.height <= 0) {
+        gdx_port_logf("[video-capture] invalid drawable size %dx%d\n", sCapture.width,
+                      sCapture.height);
+        sCapture.finished = true;
+        return false;
+    }
+
+    const char* expected = std::getenv("GDX_VIDEO_CAPTURE_SIZE");
+    if (expected != nullptr && expected[0] != '\0') {
+        int expectedWidth = 0;
+        int expectedHeight = 0;
+        char trailing = '\0';
+        if (std::sscanf(expected, "%dx%d%c", &expectedWidth, &expectedHeight, &trailing) != 2 ||
+            expectedWidth != sCapture.width || expectedHeight != sCapture.height) {
+            gdx_port_logf("[video-capture] drawable is %dx%d, expected %s\n", sCapture.width,
+                          sCapture.height, expected);
+            sCapture.finished = true;
+            return false;
+        }
+    }
+
+    const size_t pixels = static_cast<size_t>(sCapture.width) * static_cast<size_t>(sCapture.height);
+    if (pixels > std::numeric_limits<size_t>::max() / 4) {
+        gdx_port_logf("[video-capture] drawable is too large\n");
+        sCapture.finished = true;
+        return false;
+    }
+    sCapture.rgba.resize(pixels * 4);
+
+    gdx_port_logf("[video-capture] opening %s (%dx%d bottom-up RGBA8, limit=%llu)\n", path,
+                  sCapture.width, sCapture.height,
+                  static_cast<unsigned long long>(sCapture.maxFrames));
+    sCapture.stream = std::fopen(path, "wb");
+    if (sCapture.stream == nullptr) {
+        gdx_port_logf("[video-capture] open FAILED: %s\n", std::strerror(errno));
+        sCapture.finished = true;
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+extern "C" void gdx_video_capture_frame(void) {
+    if (!sCapture.initialized && !initializeCapture()) {
+        return;
+    }
+    if (sCapture.finished || sCapture.stream == nullptr) {
+        return;
+    }
+
+    GLint oldPackAlignment = 4;
+    glGetIntegerv(GL_PACK_ALIGNMENT, &oldPackAlignment);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    // The renderer may deliberately probe unsupported state and leave an error
+    // pending. Attribute only an error raised by this readback call.
+    while (glGetError() != GL_NO_ERROR) {
+    }
+    glReadPixels(0, 0, sCapture.width, sCapture.height, GL_RGBA, GL_UNSIGNED_BYTE,
+                 sCapture.rgba.data());
+    glPixelStorei(GL_PACK_ALIGNMENT, oldPackAlignment);
+
+    const GLenum glError = glGetError();
+    if (glError != GL_NO_ERROR) {
+        gdx_port_logf("[video-capture] glReadPixels FAILED: 0x%04x\n",
+                      static_cast<unsigned int>(glError));
+        finishCapture("aborted");
+        return;
+    }
+
+    const size_t written = std::fwrite(sCapture.rgba.data(), 1, sCapture.rgba.size(), sCapture.stream);
+    if (written != sCapture.rgba.size()) {
+        gdx_port_logf("[video-capture] write FAILED: %s\n", std::strerror(errno));
+        finishCapture("aborted");
+        return;
+    }
+
+    ++sCapture.frame;
+    if (sCapture.maxFrames != 0 && sCapture.frame >= sCapture.maxFrames) {
+        finishCapture("completed");
+    }
+}
+
+extern "C" int gdx_video_capture_finished(void) {
+    return sCapture.active && sCapture.finished && sCapture.frame > 0;
+}
+
+extern "C" void gdx_video_capture_shutdown(void) {
+    if (sCapture.active && !sCapture.finished) {
+        finishCapture("stopped");
+    }
+}
