+extern "C" int gdx_rl_export_dash_pads(uint32_t capacity, GdxRlDashPad* pads,
+                                         uint32_t* out_count) {
+    if (!on_owner_thread()) {
+        return -1;
+    }
+    if (out_count == nullptr) {
+        set_error("dash-pad export count pointer is null");
+        return -1;
+    }
+    *out_count = sDashPadCount;
+    if (capacity == 0) {
+        if (pads != nullptr) {
+            set_error("dash-pad count query requires a null pads pointer");
+            return -1;
+        }
+        return 0;
+    }
+    if (pads == nullptr) {
+        set_error("dash-pad export storage is null");
+        return -1;
+    }
+    if (capacity < sDashPadCount) {
+        set_error("dash-pad export capacity is smaller than the required count");
+        return -1;
+    }
+    if (sDashPadCount > 0) {
+        std::memcpy(pads, sDashPads, sDashPadCount * sizeof(GdxRlDashPad));
+    }
+    return 0;
+}
