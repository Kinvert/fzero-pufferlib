+    std::uint8_t segment = 0;
+    std::uint32_t romBase = 0;
+    bool compressed = false;
+    std::size_t size = 0;
+    std::unique_ptr<std::uint8_t[]> bytes;
+};
+
+struct ResolvedAsset {
