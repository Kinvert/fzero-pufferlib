+#include "../n64_gfx_bridge.h"
+#include "gdx_headless_host.h"
+
+#define GDX_HEADLESS_VI_CYCLES 781250ULL
+#define GDX_HEADLESS_SRAM_SIZE 0x8000u
+#define GDX_HEADLESS_MAX_TIMERS 32
+#define GDX_HEADLESS_MAX_FRAMEBUFFERS 4
+
+extern void gdx_register_host_range(void* ptr, size_t size);
+
+/* ------------------------------------------------------------------------------------------ */
+/* Virtual clock and libultra timers.                                                         */
+/* ------------------------------------------------------------------------------------------ */
+
+typedef struct GdxHeadlessTimerSlot {
+    OSTimer* timer;
+    OSTime deadline;
+} GdxHeadlessTimerSlot;
+
+static OSTime sHeadlessTime;
+static GdxHeadlessTimerSlot sHeadlessTimers[GDX_HEADLESS_MAX_TIMERS];
+extern s32 osAppNMIBuffer[16];
+
+static void gdx_headless_fire_timers(void) {
+    int i;
+    for (i = 0; i < GDX_HEADLESS_MAX_TIMERS; ++i) {
+        OSTimer* timer = sHeadlessTimers[i].timer;
+        if (timer == NULL || sHeadlessTime < sHeadlessTimers[i].deadline) {
+            continue;
+        }
+        if (timer->mq != NULL) {
+            osSendMesg(timer->mq, timer->msg, OS_MESG_NOBLOCK);
+        }
+        if (timer->interval != 0) {
+            do {
+                sHeadlessTimers[i].deadline += timer->interval;
+            } while (sHeadlessTimers[i].deadline <= sHeadlessTime);
+            timer->value = sHeadlessTimers[i].deadline - sHeadlessTime;
+        } else {
+            timer->value = 0;
+            sHeadlessTimers[i].timer = NULL;
+        }
+    }
+}
+
+void gdx_headless_clock_reset(unsigned long long cycles) {
+    sHeadlessTime = (OSTime) cycles;
+    memset(sHeadlessTimers, 0, sizeof(sHeadlessTimers));
+}
+
+void gdx_headless_clock_advance_vi(void) {
+    sHeadlessTime += (OSTime) GDX_HEADLESS_VI_CYCLES;
+    gdx_headless_fire_timers();
+}
+
+unsigned long long gdx_headless_clock_cycles(void) {
+    return (unsigned long long) sHeadlessTime;
+}
+
+void gdx_headless_prepare_cartridge_boot(void) {
+    /* Main_ThreadEntry otherwise interprets the host's deliberately generous 16 MiB RDRAM as a
+       64DD-compatible Expansion Pak and clears generated one-byte leo linker placeholders as if
+       they were a real overlay BSS span. The retained NMI word is the game's own supported path
+       for publishing the already-detected compatibility result. */
+    osAppNMIBuffer[14] = 0;
+    osAppNMIBuffer[15] = (s32) 0x20DE1529u;
+}
+
+OSTime osGetTime(void) {
+    return sHeadlessTime;
+}
+
+void osSetTime(OSTime time) {
+    sHeadlessTime = time;
+}
+
+u32 osGetCount(void) {
+    return (u32) sHeadlessTime;
+}
+
+int osSetTimer(OSTimer* timer, OSTime countdown, OSTime interval, OSMesgQueue* mq, OSMesg msg) {
+    int i;
+    if (timer == NULL) {
+        return -1;
+    }
+    (void) osStopTimer(timer);
+    for (i = 0; i < GDX_HEADLESS_MAX_TIMERS; ++i) {
+        if (sHeadlessTimers[i].timer == NULL) {
+            timer->next = NULL;
+            timer->prev = NULL;
+            timer->interval = interval;
+            timer->value = countdown;
+            timer->mq = mq;
+            timer->msg = msg;
+            sHeadlessTimers[i].timer = timer;
+            sHeadlessTimers[i].deadline = sHeadlessTime + countdown;
+            return 0;
+        }
+    }
+    return -1;
+}
+
+int osStopTimer(OSTimer* timer) {
+    int i;
+    for (i = 0; i < GDX_HEADLESS_MAX_TIMERS; ++i) {
+        if (sHeadlessTimers[i].timer == timer) {
+            sHeadlessTimers[i].timer = NULL;
+            if (timer != NULL) {
+                timer->value = 0;
+            }
+            return 0;
+        }
+    }
+    return -1;
+}
+
+/* ------------------------------------------------------------------------------------------ */
+/* Input. input_bridge.c still derives digital directions and pressed/released edges.          */
+/* ------------------------------------------------------------------------------------------ */
+
+static u16 sHeadlessButtons;
+static s8 sHeadlessStickX;
+static s8 sHeadlessStickY;
+static int (*sGameThreadResetHook)(void);
+
+void gdx_headless_set_pad(unsigned short buttons, signed char stick_x, signed char stick_y) {
+    if (stick_x < -80) stick_x = -80;
+    if (stick_x > 80) stick_x = 80;
+    if (stick_y < -80) stick_y = -80;
+    if (stick_y > 80) stick_y = 80;
+    sHeadlessButtons = (u16) buttons;
+    sHeadlessStickX = (s8) stick_x;
+    sHeadlessStickY = (s8) stick_y;
+}
+
+void gdx_headless_clear_pad(void) {
+    gdx_headless_set_pad(0, 0, 0);
+}
+
+void gdx_headless_set_game_thread_reset_hook(int (*hook)(void)) {
+    sGameThreadResetHook = hook;
+}
+
+int gdx_rl_game_thread_reset(void) {
+    return sGameThreadResetHook != NULL ? sGameThreadResetHook() : 0;
+}
+
+int gdx_lus_read_pads(int capacity, u16* out_buttons, s8* out_stick_x, s8* out_stick_y,
+                      u8* out_connected) {
+    int i;
+    if (capacity <= 0 || out_buttons == NULL || out_stick_x == NULL || out_stick_y == NULL ||
+        out_connected == NULL) {
+        return 0;
+    }
+    for (i = 0; i < capacity; ++i) {
+        out_buttons[i] = 0;
+        out_stick_x[i] = 0;
+        out_stick_y[i] = 0;
+        out_connected[i] = 0;
+    }
+    out_buttons[0] = sHeadlessButtons;
+    out_stick_x[0] = sHeadlessStickX;
+    out_stick_y[0] = sHeadlessStickY;
+    out_connected[0] = 1;
+    return 1;
+}
+
+s32 osContStartReadData(OSMesgQueue* mq) {
+    if (mq != NULL) {
+        osSendMesg(mq, NULL, OS_MESG_NOBLOCK);
+    }
+    return 0;
+}
+
+void osContGetReadData(OSContPad* data) {
+    int i;
+    if (data == NULL) return;
+    memset(data, 0, sizeof(OSContPad) * 4u);
+    data[0].button = sHeadlessButtons;
+    data[0].stick_x = sHeadlessStickX;
+    data[0].stick_y = sHeadlessStickY;
+    for (i = 1; i < 4; ++i) {
+        data[i].errno = CONT_NO_RESPONSE_ERROR;
+    }
+}
+
+s32 osMotorInit(OSMesgQueue* mq, OSPfs* pfs, int channel) {
+    (void) mq;
