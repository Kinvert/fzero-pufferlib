+void configure_time_attack() {
+    gNumPlayers = 1;
+    gCourseIndex = sConfig.course_index;
+    gTotalLapCount = sConfig.laps;
+    gPlayerCharacters[0] = static_cast<s16>(sConfig.character);
+    gPlayerMachineSkins[0] = static_cast<s16>(sConfig.machine_skin);
+    gPlayerEngine[0] = sConfig.engine_balance;
+    gCurrentGhostType = GHOST_NONE;
+    gTitleDemoState = TITLE_DEMO_INACTIVE;
+    gSelectedMode = MODE_TIME_ATTACK;
+    gCurrentTrackName = gTrackNames[gCourseIndex];
+}
+
+int game_thread_reset() {
+    if (!sResetPending) {
+        return 0;
+    }
+    sResetPending = false;
+    configure_time_attack();
+    gGameFrameCount = 0;
+    Math_Rand1Init(static_cast<s32>(sResetSeed), static_cast<s32>(sResetSeed + sResetSeed));
+    Math_Rand2Init(static_cast<s32>(sResetSeed + sResetSeed), static_cast<s32>(sResetSeed));
+    func_i2_80103A70();
+
+    /* Preserve the canonical control-arm edge at 40. The host reset call advances one neutral
+       game frame from 41 to 40, then removes the remaining countdown. */
+    gRaceIntroTimer = 41;
+    gEnableRaceSfx = 0;
+    sResetConsumed = true;
+    return 1;
+}
+
+bool validate_config(const GdxRlConfig& config) {
+    if (config.course_index < 0 || config.course_index >= 24) {
+        set_error("course_index must select one of the 24 cartridge courses");
+        return false;
+    }
+    if (config.character < 0 || config.character >= TOTAL_RACER_COUNT) {
+        set_error("character must be in [0, 29]");
+        return false;
+    }
+    if (config.machine_skin < 0 || config.machine_skin > 3) {
+        set_error("machine_skin must be in [0, 3]");
+        return false;
+    }
+    if (config.laps < 1 || config.laps > 3) {
+        set_error("laps must be in [1, 3]");
+        return false;
+    }
+    if (config.action_repeat < 2 || config.action_repeat > 16) {
+        set_error("action_repeat must be in [2, 16] so boost taps include a release tick");
+        return false;
+    }
+    if (config.max_episode_frames < 1 || config.stall_frames < 0 ||
+        !std::isfinite(config.stall_progress) || config.stall_progress < 0.0f) {
+        set_error("episode limits are invalid");
+        return false;
+    }
+    if (!(config.engine_balance >= 0.0f && config.engine_balance <= 1.0f)) {
+        set_error("engine_balance must be in [0, 1]");
+        return false;
+    }
+    if (config.cpu_oracle > 1) {
+        set_error("cpu_oracle must be 0 or 1");
+        return false;
+    }
+    return true;
+}
+
+GdxRlTerminationReason failure_reason(int state_flags) {
+    if (state_flags & RACER_STATE_FINISHED) {
+        return GDX_RL_FINISHED;
+    }
+    if (state_flags & RACER_STATE_SPINNING_OUT) {
+        return GDX_RL_SPINNING_OUT;
+    }
+    if (state_flags & RACER_STATE_FALLING_OFF_TRACK) {
+        return GDX_RL_FALLING;
+    }
+    if (state_flags & RACER_STATE_CRASHED) {
+        return GDX_RL_CRASHED;
+    }
+    if (state_flags & RACER_STATE_RETIRED) {
+        return GDX_RL_RETIRED;
+    }
+    return GDX_RL_RUNNING;
+}
