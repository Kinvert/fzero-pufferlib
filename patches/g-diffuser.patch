+/*
+ * CPU-only address and cartridge-asset resolver for the headless RL runtime.
+ *
+ * This is intentionally independent of libultraship and the Fast3D interpreter.  The game still
+ * builds its normal display lists; this file only gives the recompiled CPU code stable host
+ * addresses for generated linker placeholders and raw-ROM segment images.  Decoded images live
+ * until process exit because gSegments[] and generated display-list words retain their addresses.
+ */
+
+#if defined(__linux__) && !defined(_GNU_SOURCE)
+#define _GNU_SOURCE
+#endif
+
+#include "../gdx_segment_source.h"
+#include "../rom_buffer.h"
+
+extern "C" {
+#include "../../torch/lib/libmio0/mio0.h"
+}
+
+#include <algorithm>
+#include <atomic>
+#include <cstdarg>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <new>
+#include <utility>
+#include <vector>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#elif defined(__linux__)
+#include <link.h>
+#elif defined(__unix__) || defined(__APPLE__)
+#include <dlfcn.h>
+#endif
+
+extern "C" unsigned long long gSegments[16];
+
+extern "C" unsigned short D_8014A20[];
+extern "C" unsigned short D_A000000_235130[];
+extern "C" unsigned short D_A000000_239A80[];
+extern "C" unsigned short D_A000000_23EC50[];
+extern "C" unsigned short D_A000000_243D90[];
+extern "C" unsigned short D_A000000_24A270[];
+extern "C" unsigned short D_A000000_2507F0[];
+extern "C" unsigned short D_A000000_255100[];
+extern "C" unsigned short D_A000000_259600[];
+extern "C" unsigned short D_A000000_25F360[];
