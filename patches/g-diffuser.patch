+
+    std::vector<fs::path> romCandidates;
+    if (const char* envRom = std::getenv("FZEROX_ROM"); envRom != nullptr && envRom[0] != '\0') {
+        romCandidates.emplace_back(envRom);
+    }
+    for (const char* name : kRomDevCandidates) {
+        romCandidates.emplace_back(exeDir / name);
+        if (cwd != exeDir) {
+            romCandidates.emplace_back(cwd / name);
+        }
+    }
+
+    for (const fs::path& candidate : romCandidates) {
+        std::string why;
+        if (!fileExists(candidate) || !validateRom(candidate, why)) {
+            continue;
+        }
+        const fs::path absoluteCandidate = fs::absolute(candidate, ec);
+        ec.clear();
+        const GdxInputRecognition recognition =
+            GdxRecognizeInput(kRomName, absoluteCandidate.string(), exeDir.string());
+        if (recognition.verdict != GdxInputVerdict::VerifiedKnown) {
+            gdx_port_logf("[firstboot] cartridge-only ROM rejected: %s (%s)\n",
+                          absoluteCandidate.string().c_str(), recognition.message.c_str());
+            continue;
+        }
+        result.status = FirstBootStatus::SetupComplete;
+        result.romPath = absoluteCandidate.string();
+        gdx_port_logf("[firstboot] cartridge-only boot: ROM=%s; 64DD disk/IPL not required\n",
+                      result.romPath.c_str());
+        return result;
+    }
+
+    if (gameArchiveSatisfies(cartridgeDataDir)) {
+        result.status = FirstBootStatus::SetupComplete;
+        gdx_port_logf("[firstboot] cartridge-only archive boot: ROM served from %s\n",
+                      kGameArchiveName);
+        return result;
+    }
+
+    result.status = FirstBootStatus::NeedsSetup;
+    gdx_port_logf("[firstboot] cartridge-only build needs a US rev0 ROM; set FZEROX_ROM or place %s "
+                  "beside the executable\n", kRomName);
+    return result;
+#endif
+
     // A ROM beside the executable is normal for a portable release and must not bypass first-time
     // setup. Preserve the headless shortcut only for a real source tree that already provides the
     // development generic.o2r archive.
