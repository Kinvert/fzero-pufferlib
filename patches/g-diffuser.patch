+
+void HeadlessLog(const char* format, ...) {
+    std::va_list args;
+    va_start(args, format);
+    std::fputs("[headless-assets] ", stderr);
+    std::vfprintf(stderr, format, args);
+    std::fputc('\n', stderr);
+    va_end(args);
+}
+
+std::uint32_t Low32(std::uintptr_t value) {
+    return static_cast<std::uint32_t>(value);
+}
+
+std::uint32_t ReadBigEndian32(const std::uint8_t* src) {
+    return (static_cast<std::uint32_t>(src[0]) << 24) |
+           (static_cast<std::uint32_t>(src[1]) << 16) |
+           (static_cast<std::uint32_t>(src[2]) << 8) |
+           static_cast<std::uint32_t>(src[3]);
+}
+
+bool IsValidHostRange(std::uintptr_t begin, std::size_t size) {
+    return begin != 0 && size != 0 && size <= std::numeric_limits<std::uintptr_t>::max() - begin;
+}
+
+void AddHostRange(std::vector<HostRange>& ranges, std::uintptr_t begin, std::size_t size) {
+    if (!IsValidHostRange(begin, size)) {
+        return;
+    }
+    const auto duplicate = std::find_if(ranges.begin(), ranges.end(), [begin, size](const HostRange& range) {
+        return range.begin == begin && range.size == size;
+    });
+    if (duplicate == ranges.end()) {
+        ranges.push_back({begin, size});
+    }
+}
+
+std::size_t RegisteredHostRemainingLocked(std::uintptr_t host) {
+    std::size_t best = 0;
+    for (const HostRange& range : gHostRanges) {
+        if (range.begin == 0 || range.size == 0 || host < range.begin) {
+            continue;
+        }
+        const std::uintptr_t offset = host - range.begin;
+        if (offset < range.size) {
+            best = std::max(best, range.size - static_cast<std::size_t>(offset));
+        }
+    }
+    return best;
+}
+
+#if defined(__linux__)
+struct ModuleSearch {
+    std::uintptr_t target = 0;
+    ModuleRange result;
+};
+
+int FindContainingElfModule(dl_phdr_info* info, std::size_t, void* opaque) {
+    auto* search = static_cast<ModuleSearch*>(opaque);
+    ModuleRange candidate;
+    bool containsTarget = false;
+
+    for (std::size_t i = 0; i < info->dlpi_phnum; ++i) {
+        const ElfW(Phdr)& phdr = info->dlpi_phdr[i];
+        if (phdr.p_type != PT_LOAD || phdr.p_memsz == 0) {
+            continue;
+        }
+
+        const std::uintptr_t begin = static_cast<std::uintptr_t>(info->dlpi_addr) +
+                                     static_cast<std::uintptr_t>(phdr.p_vaddr);
+        if (phdr.p_memsz > std::numeric_limits<std::uintptr_t>::max() - begin) {
+            continue;
+        }
+        const std::uintptr_t end = begin + static_cast<std::uintptr_t>(phdr.p_memsz);
+        if (!candidate.valid()) {
+            candidate.begin = begin;
+            candidate.end = end;
+        } else {
+            candidate.begin = std::min(candidate.begin, begin);
+            candidate.end = std::max(candidate.end, end);
+        }
+        containsTarget = containsTarget || (search->target >= begin && search->target < end);
+    }
+
+    if (!containsTarget || !candidate.valid()) {
+        return 0;
+    }
+    search->result = candidate;
+    return 1;
+}
+#endif
+
+ModuleRange DiscoverGameModuleRange() {
+    /* The generated placeholder is a better anchor than the main executable.  In a PufferLib
+       Python extension the game lives in a DSO, while /proc/self/exe names Python itself. */
+    const std::uintptr_t anchor = reinterpret_cast<std::uintptr_t>(D_A000000_235130);
+
+#if defined(_WIN32)
+    HMODULE module = nullptr;
+    const DWORD flags = GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                        GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT;
+    if (!GetModuleHandleExA(flags, reinterpret_cast<LPCSTR>(anchor), &module) || module == nullptr) {
+        return {};
+    }
+    const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(module);
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE) {
+        return {};
+    }
+    const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS*>(
+        reinterpret_cast<const std::uint8_t*>(module) + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.SizeOfImage == 0) {
+        return {};
+    }
+    const std::uintptr_t begin = reinterpret_cast<std::uintptr_t>(module);
+    return {begin, begin + nt->OptionalHeader.SizeOfImage};
+#elif defined(__linux__)
+    ModuleSearch search;
+    search.target = anchor;
+    dl_iterate_phdr(FindContainingElfModule, &search);
+    return search.result;
+#elif defined(__unix__) || defined(__APPLE__)
+    Dl_info info{};
+    if (dladdr(reinterpret_cast<const void*>(anchor), &info) == 0 || info.dli_fbase == nullptr) {
+        return {};
+    }
+    /* dladdr exposes the correct DSO base but no image extent.  Fail closed rather than treating
+       an unbounded region as module memory; the supported headless platforms use ELF or PE. */
+    return {};
+#else
+    (void)anchor;
+    return {};
+#endif
+}
+
+const ModuleRange& GameModuleRange() {
+    static const ModuleRange range = DiscoverGameModuleRange();
+    return range;
+}
+
+bool LookupAssetSegment(std::uint32_t raw, AssetSegmentLookup& out) {
+    unsigned char segment = 0;
+    unsigned int romBase = 0;
+    unsigned char compressed = 0;
+    unsigned int offset = 0;
+    unsigned int imageSize = 0;
+
+    if (gdx_lookup_asset_segment(raw, &segment, &romBase, &compressed, &offset, &imageSize) == 0 &&
+        gdx_lookup_asset_segment_interior(raw, &segment, &romBase, &compressed, &offset,
+                                          &imageSize) == 0) {
+        return false;
+    }
+    if (segment >= 16u) {
+        return false;
+    }
+
+    out.segment = segment;
+    out.romBase = romBase;
+    out.compressed = compressed != 0;
+    out.offset = offset;
+    out.imageSize = imageSize;
+    return true;
+}
+
+LoadedAssetSegment* FindLoadedAsset(const AssetSegmentLookup& lookup) {
+    const auto found = std::find_if(
+        gLoadedAssetSegments.begin(), gLoadedAssetSegments.end(),
+        [&lookup](const LoadedAssetSegment& loaded) {
+            return loaded.segment == lookup.segment && loaded.romBase == lookup.romBase &&
+                   loaded.compressed == lookup.compressed && loaded.bytes != nullptr && loaded.size != 0;
+        });
+    return found == gLoadedAssetSegments.end() ? nullptr : &*found;
+}
+
+bool DecodeMio0Asset(const AssetSegmentLookup& lookup,
+                     bool romUsable,
+                     const std::uint8_t header[MIO0_HEADER_LENGTH],
+                     std::unique_ptr<std::uint8_t[]>& outBytes,
+                     std::size_t& outSize) {
+    std::uint32_t blobSpan = 0;
+    std::size_t stageSize = 0;
+    if (GdxSegmentSourceContainingSpan(lookup.romBase, &blobSpan) != 0 &&
+        blobSpan >= MIO0_HEADER_LENGTH) {
+        stageSize = blobSpan;
+    } else if (romUsable) {
+        const std::uint32_t decodedSize = ReadBigEndian32(header + 4);
+        const std::uint32_t uncompressedOffset = ReadBigEndian32(header + 12);
+        const std::size_t inputBound = static_cast<std::size_t>(uncompressedOffset) + decodedSize;
+        stageSize = std::min(inputBound, gdx_rom_size - lookup.romBase);
+    }
+    if (stageSize < MIO0_HEADER_LENGTH || stageSize > std::numeric_limits<std::uint32_t>::max()) {
+        return false;
+    }
+
+    std::vector<std::uint8_t> stage(stageSize);
+    if (GdxSegmentSourceRead(lookup.romBase, static_cast<std::uint32_t>(stageSize), stage.data()) == 0 ||
+        std::memcmp(stage.data(), "MIO0", 4) != 0) {
+        return false;
+    }
+
+    const std::uint32_t decodedSize = ReadBigEndian32(stage.data() + 4);
+    outSize = std::max<std::size_t>(decodedSize, lookup.imageSize);
+    if (decodedSize == 0 || outSize == 0 || outSize > std::numeric_limits<std::uint32_t>::max()) {
+        return false;
+    }
+
+    outBytes.reset(new (std::nothrow) std::uint8_t[outSize]());
+    if (outBytes == nullptr) {
+        return false;
+    }
+    const int decoded = mio0_decode(stage.data(), outBytes.get(), nullptr);
+    return decoded > 0 && static_cast<std::size_t>(decoded) <= outSize;
+}
+
+bool LoadAssetBytes(const AssetSegmentLookup& lookup,
+                    std::unique_ptr<std::uint8_t[]>& outBytes,
+                    std::size_t& outSize) {
+    std::uint32_t blobSpan = 0;
+    const bool haveBlobSpan = GdxSegmentSourceContainingSpan(lookup.romBase, &blobSpan) != 0;
+    const bool romUsable = gdx_rom_buffer != nullptr && lookup.romBase < gdx_rom_size;
+    if (!haveBlobSpan && !romUsable) {
+        return false;
+    }
+
+    std::uint8_t header[MIO0_HEADER_LENGTH]{};
+    const bool haveHeader =
+        GdxSegmentSourceRead(lookup.romBase, MIO0_HEADER_LENGTH, header) != 0;
+    const bool isMio0 = haveHeader && std::memcmp(header, "MIO0", 4) == 0;
+
+    /* Several generated venue rows say uncompressed although the cartridge bytes are MIO0.
+       Cartridge magic is authoritative; otherwise seg 0x0A would point at compressed data. */
+    if (lookup.compressed || isMio0) {
+        return isMio0 && DecodeMio0Asset(lookup, romUsable, header, outBytes, outSize);
+    }
+
+    const std::size_t available = romUsable ? gdx_rom_size - lookup.romBase : blobSpan;
+    outSize = lookup.imageSize != 0 ? lookup.imageSize
+                                    : std::min<std::size_t>(available, kMaxPlainAssetBytes);
+    if (outSize == 0 || outSize > available ||
+        outSize > std::numeric_limits<std::uint32_t>::max()) {
+        return false;
+    }
+
+    outBytes.reset(new (std::nothrow) std::uint8_t[outSize]());
+    return outBytes != nullptr &&
+           GdxSegmentSourceRead(lookup.romBase, static_cast<std::uint32_t>(outSize), outBytes.get()) != 0;
+}
+
+bool EnsureAssetSegmentForSymbol(std::uint32_t symbolLow32, ResolvedAsset& resolved) {
+    AssetSegmentLookup lookup;
+    {
+        /* AssetBindings lazily builds its low32 index, so serialize lookup as well as cache access. */
+        std::lock_guard<std::mutex> assetLock(gAssetMutex);
+        if (!LookupAssetSegment(symbolLow32, lookup)) {
+            return false;
+        }
+
+        LoadedAssetSegment* loaded = FindLoadedAsset(lookup);
+        if (loaded != nullptr) {
+            const std::uintptr_t base = reinterpret_cast<std::uintptr_t>(loaded->bytes.get());
+            if (gSegments[lookup.segment] == 0) {
+                gSegments[lookup.segment] = static_cast<unsigned long long>(base);
+            }
+            if (lookup.offset >= loaded->size) {
+                return false;
+            }
+            resolved.base = base;
+            resolved.offset = lookup.offset;
+            resolved.capacity = loaded->size - lookup.offset;
+            return true;
+        }
+    }
+
+    /* mio0_decode cooperatively yields every few KiB in the game build.  Never hold a native
+       mutex across that yield: another fiber on this same OS thread could enter the resolver and
+       block the host thread forever waiting for a mutex whose owner is the suspended fiber. */
+    LoadedAssetSegment newAsset;
+    newAsset.segment = lookup.segment;
+    newAsset.romBase = lookup.romBase;
+    newAsset.compressed = lookup.compressed;
+    if (!LoadAssetBytes(lookup, newAsset.bytes, newAsset.size)) {
+        HeadlessLog("failed to load segment=%u rom=%08X", static_cast<unsigned>(lookup.segment),
+                    lookup.romBase);
+        return false;
+    }
+    gdx_fixup_asset_segment_image(lookup.segment, lookup.romBase, newAsset.bytes.get(),
+                                  static_cast<unsigned int>(newAsset.size));
+
+    std::lock_guard<std::mutex> assetLock(gAssetMutex);
+    LoadedAssetSegment* loaded = FindLoadedAsset(lookup);
+    if (loaded == nullptr) {
+        /* Register only the winning buffer.  A duplicate decode can lose this publication race;
+           registering its command ranges first would leave dangling addresses after it is freed. */
+        gdx_register_asset_segment_command_ranges(
+            lookup.segment, lookup.romBase, newAsset.bytes.get(),
+            static_cast<unsigned int>(newAsset.size));
+
+        gLoadedAssetSegments.emplace_back(std::move(newAsset));
+        loaded = &gLoadedAssetSegments.back();
+
+        const std::uintptr_t base = reinterpret_cast<std::uintptr_t>(loaded->bytes.get());
+        std::lock_guard<std::mutex> rangeLock(gRangeMutex);
+        AddHostRange(gHostRanges, base, loaded->size);
+        AddHostRange(gHostRawN64Ranges, base, loaded->size);
+    }
+
+    const std::uintptr_t base = reinterpret_cast<std::uintptr_t>(loaded->bytes.get());
+    /* First claim only.  Segment 0x0A is selected authoritatively by the venue loader, while
+       mode-owned segments 4/7/9 may already point at mutable RDRAM carves. */
+    if (gSegments[lookup.segment] == 0) {
+        gSegments[lookup.segment] = static_cast<unsigned long long>(base);
+    }
+
+    if (lookup.offset >= loaded->size) {
+        return false;
+    }
+    resolved.base = base;
+    resolved.offset = lookup.offset;
+    resolved.capacity = loaded->size - lookup.offset;
+    return true;
+}
+
+} // namespace
+
+extern "C" void gdx_segment_epoch_begin(void) {
+    gSegmentEpoch.fetch_add(1u, std::memory_order_acq_rel);
+}
+
+extern "C" void gdx_segment_epoch_end(void) {
+    gSegmentEpoch.fetch_add(1u, std::memory_order_acq_rel);
+}
+
+extern "C" void gdx_register_host_range(void* ptr, std::size_t size) {
+    std::lock_guard<std::mutex> lock(gRangeMutex);
+    AddHostRange(gHostRanges, reinterpret_cast<std::uintptr_t>(ptr), size);
+}
+
+extern "C" void gdx_register_host_n64_command_range(void* ptr, std::size_t size) {
+    std::lock_guard<std::mutex> lock(gRangeMutex);
+    AddHostRange(gHostN64CommandRanges, reinterpret_cast<std::uintptr_t>(ptr), size);
+}
+
+extern "C" void gdx_register_host_wide_command_range(void* ptr, std::size_t size) {
+    std::lock_guard<std::mutex> lock(gRangeMutex);
+    AddHostRange(gHostWideCommandRanges, reinterpret_cast<std::uintptr_t>(ptr), size);
+}
+
+extern "C" void gdx_register_host_raw_n64_range(void* ptr, std::size_t size) {
+    std::lock_guard<std::mutex> lock(gRangeMutex);
+    AddHostRange(gHostRawN64Ranges, reinterpret_cast<std::uintptr_t>(ptr), size);
+}
+
+extern "C" void gdx_register_host_pointer_stub(void* ptr, std::size_t size) {
+    std::lock_guard<std::mutex> lock(gRangeMutex);
+    AddHostRange(gHostPointerStubs, reinterpret_cast<std::uintptr_t>(ptr), size);
+}
+
+extern "C" void gdx_register_n64_address_range(unsigned int n64Begin, void* hostBegin,
+                                                  std::size_t size) {
+    const std::uintptr_t host = reinterpret_cast<std::uintptr_t>(hostBegin);
+    if (n64Begin == 0 || !IsValidHostRange(host, size)) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(gRangeMutex);
+    const auto duplicate = std::find_if(
+        gN64AddressRanges.begin(), gN64AddressRanges.end(),
+        [n64Begin, host, size](const N64AddressRange& range) {
+            return range.n64Begin == n64Begin && range.hostBegin == host && range.size == size;
+        });
+    if (duplicate == gN64AddressRanges.end()) {
+        gN64AddressRanges.push_back({n64Begin, host, size});
+    }
+}
+
+extern "C" std::size_t gdx_registered_host_capacity(const void* host) {
+    std::lock_guard<std::mutex> lock(gRangeMutex);
+    return RegisteredHostRemainingLocked(reinterpret_cast<std::uintptr_t>(host));
+}
+
+extern "C" void* gdx_resolve_registered_host_address(unsigned int addr) {
+    std::lock_guard<std::mutex> lock(gRangeMutex);
+    for (int pass = 0; pass < 2; ++pass) {
+        const std::uint32_t candidate =
+            pass == 0 ? static_cast<std::uint32_t>(addr)
+                      : (static_cast<std::uint32_t>(addr) | 0x80000000u);
+        if (pass == 1 && candidate == addr) {
+            break;
+        }
+        for (const HostRange& range : gHostRanges) {
+            if (range.begin == 0 || range.size == 0) {
+                continue;
+            }
+            const std::uint32_t offset = candidate - Low32(range.begin);
+            if (static_cast<std::size_t>(offset) < range.size) {
+                return reinterpret_cast<void*>(range.begin + offset);
+            }
+        }
+    }
+    return nullptr;
+}
+
+extern "C" void gdx_register_main_module_range(void) {
+    const ModuleRange& module = GameModuleRange();
+    if (!module.valid()) {
+        HeadlessLog("could not discover the game module range");
+        return;
+    }
+    gdx_register_host_range(reinterpret_cast<void*>(module.begin), module.end - module.begin);
+}
+
+extern "C" void* gdx_resolve_module_host_address(unsigned int addr) {
+    const ModuleRange& module = GameModuleRange();
+    if (!module.valid()) {
+        return nullptr;
+    }
+
+    for (int pass = 0; pass < 2; ++pass) {
+        const std::uint32_t candidate =
+            pass == 0 ? static_cast<std::uint32_t>(addr)
+                      : (static_cast<std::uint32_t>(addr) | 0x80000000u);
+        if (pass == 1 && candidate == addr) {
+            break;
+        }
+
+        std::uintptr_t full = (module.begin & ~static_cast<std::uintptr_t>(0xFFFFFFFFu)) |
+                              static_cast<std::uintptr_t>(candidate);
+        if (full < module.begin &&
+            full <= std::numeric_limits<std::uintptr_t>::max() - UINT64_C(0x100000000)) {
+            full += UINT64_C(0x100000000);
+        }
+        if (full >= module.begin && full < module.end) {
+            return reinterpret_cast<void*>(full);
+        }
+    }
+    return nullptr;
+}
+
+extern "C" void* gdx_ensure_asset_segment_for_symbol(unsigned int symLow32,
+                                                       unsigned int* outOffset) {
+    ResolvedAsset resolved;
+    if (!EnsureAssetSegmentForSymbol(symLow32, resolved)) {
+        if (outOffset != nullptr) {
+            *outOffset = 0;
+        }
+        return nullptr;
+    }
+    if (outOffset != nullptr) {
+        *outOffset = resolved.offset;
+    }
+    return reinterpret_cast<void*>(resolved.base);
+}
+
+extern "C" int gdx_wide_asset_resolve_enabled(void) {
+    return 1;
+}
+
+extern "C" void* gdx_resolve_wide_asset_pointer(const void* full) {
+    const std::uintptr_t address = reinterpret_cast<std::uintptr_t>(full);
+    const ModuleRange& module = GameModuleRange();
+    if (address == 0 || !module.valid() || address < module.begin || address >= module.end) {
+        return nullptr;
+    }
+
+    ResolvedAsset resolved;
+    if (!EnsureAssetSegmentForSymbol(Low32(address), resolved)) {
+        return nullptr;
+    }
+    return reinterpret_cast<void*>(resolved.base + resolved.offset);
+}
+
+extern "C" int gdx_load_venue_texture_segment(int venue) {
+    static const void* const venueSymbols[] = {
+        D_A000000_235130,
+        D_A000000_239A80,
+        D_A000000_23EC50,
+        D_A000000_243D90,
+        D_A000000_24A270,
+        D_A000000_2507F0,
+        D_A000000_255100,
+        D_A000000_259600,
+        D_A000000_25F360,
+        D_A000000_266C20,
+        D_A000000_26D780,
+    };
+    constexpr int venueCount = static_cast<int>(sizeof(venueSymbols) / sizeof(venueSymbols[0]));
+    if (venue < 0 || venue >= venueCount) {
+        HeadlessLog("invalid venue texture segment %d", venue);
+        return 0;
+    }
+
+    ResolvedAsset resolved;
+    const std::uint32_t symbol =
+        Low32(reinterpret_cast<std::uintptr_t>(venueSymbols[venue]));
+    if (!EnsureAssetSegmentForSymbol(symbol, resolved)) {
+        return 0;
+    }
+
+    if (gSegments[0x0A] != resolved.base) {
+        gdx_segment_epoch_begin();
+        gSegments[0x0A] = static_cast<unsigned long long>(resolved.base);
+        gdx_segment_epoch_end();
+    }
+    return 1;
+}
+
+extern "C" void gdx_load_venue_building_texture(unsigned int romOffset) {
+    ResolvedAsset resolved;
+    const std::uint32_t symbol = Low32(reinterpret_cast<std::uintptr_t>(D_8014A20));
+    if (!EnsureAssetSegmentForSymbol(symbol, resolved) ||
+        resolved.capacity < kVenueBuildingTextureBytes) {
+        HeadlessLog("building texture destination did not resolve");
+        return;
+    }
+
+    const std::uint32_t romPhysical = romOffset & 0x1FFFFFFFu;
+    const std::uint32_t romBase =
+        romPhysical >= 0x10000000u ? romPhysical - 0x10000000u : romPhysical;
+    std::uint8_t staged[kVenueBuildingTextureBytes];
+    if (GdxSegmentSourceRead(romBase, static_cast<std::uint32_t>(sizeof(staged)), staged) == 0) {
+        HeadlessLog("building texture ROM read failed at %08X", romBase);
+        return;
+    }
+
+    auto* destination = reinterpret_cast<std::uint8_t*>(resolved.base + resolved.offset);
+    if (std::memcmp(destination, staged, sizeof(staged)) != 0) {
+        std::memcpy(destination, staged, sizeof(staged));
+    }
+}
+
+extern "C" void gdx_record_dma_load(unsigned int, unsigned int, unsigned int) {
+    gDmaGeneration.fetch_add(1u, std::memory_order_relaxed);
+}
+
+extern "C" void gdx_dma_report_short_dest(const void* dst, unsigned int size,
+                                            std::size_t capacity, unsigned int romOffset) {
+    static std::atomic<unsigned int> reports{0};
+    if (reports.fetch_add(1u, std::memory_order_relaxed) >= 16u) {
+        return;
+    }
+    HeadlessLog("refused DMA dst=%p bytes=%u capacity=%zu rom=%08X", dst, size, capacity,
+                romOffset);
+}
+
+/* Renderer-only cache annotations are intentionally inert in the CPU reference runtime.  Their
+   call sites remain active so draw-list construction and transition bookkeeping retain stock
+   control flow. */
+extern "C" void gdx_set_native_rgba16_texture_range(void* ptr, std::size_t size, int enabled) {
+    const std::uintptr_t begin = reinterpret_cast<std::uintptr_t>(ptr);
+    std::lock_guard<std::mutex> lock(gRangeMutex);
+    gNativeRgba16Ranges.erase(
+        std::remove_if(gNativeRgba16Ranges.begin(), gNativeRgba16Ranges.end(),
+                       [begin](const HostRange& range) { return range.begin == begin; }),
+        gNativeRgba16Ranges.end());
+    if (enabled != 0) {
+        AddHostRange(gNativeRgba16Ranges, begin, size);
+    }
+}
+
+extern "C" void gdx_defer_native_rgba16_texture_range_clear(void*) {}
+
+extern "C" void gdx_invalidate_texture_address(const void*) {}
+
+extern "C" void gfx_texture_cache_clear(void) {}
