diff --git a/port/rl/gdx_headless_smoke.cpp b/port/rl/gdx_headless_smoke.cpp
new file mode 100644
index 0000000..d1c4da5
--- /dev/null
+++ b/port/rl/gdx_headless_smoke.cpp
@@ -0,0 +1,163 @@
+/* Cartridge-only smoke driver. This is intentionally not the final PufferLib ABI. */
+
+#include <cerrno>
+#include <climits>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+extern "C" {
+#include "fzx_racer.h"
+}
+
+#include "../gdx_dev_gates.h"
+#include "../rom_buffer.h"
+#include "gdx_headless_host.h"
+
+extern "C" void GDiffuser_LoadAllAssets(void);
+extern "C" void bootproc(void);
+extern "C" void gdx_controller_poll(void);
+extern "C" void gdx_dispatch(void);
+extern "C" void gdx_rdram_init(void);
+extern "C" void gdx_register_host_range(void* ptr, size_t size);
+extern "C" void gdx_register_main_module_range(void);
+extern "C" void gdx_sched_drain_deferred_wakes(void);
+extern "C" void gdx_sched_init(void);
+extern "C" void gdx_vi_tick(void);
+
+extern "C" int gGameFrameCount;
+extern "C" int gGameMode;
+extern "C" int gQueuedGameMode;
+extern "C" short gGameModeChangeState;
+extern "C" int gCurrentGhostType;
+extern "C" char* gCurrentTrackName;
+extern "C" int gCourseIndex;
+extern "C" int gNumPlayers;
+extern "C" short gPlayerCharacters[4];
+extern "C" float gPlayerEngine[4];
+extern "C" short gPlayerMachineSkins[4];
+extern "C" int gRaceIntroTimer;
+extern "C" signed char gTitleDemoState;
+extern "C" char* gTrackNames[55];
+extern "C" int gTotalLapCount;
+extern "C" int gTotalRacers;
+extern "C" int gSelectedMode;
+
+static int parse_ticks(const char* text) {
+    char* end = nullptr;
+    long value;
+    errno = 0;
+    value = std::strtol(text, &end, 10);
+    if (errno != 0 || end == text || *end != '\0' || value <= 0 || value > INT_MAX) {
+        return -1;
+    }
+    return static_cast<int>(value);
+}
+
+int main(int argc, char** argv) {
+    int ticks = 600;
+    bool queue_time_attack = false;
+    bool time_attack_queued = false;
+    int i;
+
+    if (argc < 2) {
+        std::fprintf(stderr, "usage: %s <baserom.us.rev0.z64> [ticks] [--time-attack]\n", argv[0]);
+        return 2;
+    }
+    if (argc >= 3) {
+        ticks = parse_ticks(argv[2]);
+        if (ticks < 0) {
+            std::fprintf(stderr, "invalid tick count: %s\n", argv[2]);
+            return 2;
+        }
+    }
+    if (argc >= 4) {
+        if (std::strcmp(argv[3], "--time-attack") != 0) {
+            std::fprintf(stderr, "unknown option: %s\n", argv[3]);
+            return 2;
+        }
+        queue_time_attack = true;
+    }
+
+    gdx_dev_gates_init_env();
+    gdx_headless_clock_reset(0);
+    gdx_headless_prepare_cartridge_boot();
+    gdx_headless_clear_pad();
+    gdx_sched_init();
+    gdx_init_rom(argc, argv, 0);
+    if (gdx_rom_buffer == nullptr || gdx_rom_size < 16u * 1024u * 1024u) {
+        std::fprintf(stderr, "headless smoke: ROM failed to load\n");
+        return 1;
+    }
+
+    gdx_rdram_init();
+    gdx_register_host_range(gdx_rom_buffer, gdx_rom_size);
+    gdx_register_main_module_range();
+    GDiffuser_LoadAllAssets();
+
+    std::fprintf(stderr, "[headless] booting ROM=%s bytes=%zu ticks=%d\n",
+                 gdx_rom_path, gdx_rom_size, ticks);
+    bootproc();
+
+    for (i = 0; i < ticks; ++i) {
+        /* Queue through the normal mode-transition state machine once cold boot has reached its
+           first settled title update. The final environment will use the same transition/reset
+           path rather than invoking Race_Init out of band. */
+        if (queue_time_attack && !time_attack_queued && gGameFrameCount > 0 &&
+            ((gGameMode & 0x1F) == 0) && gGameModeChangeState == 0) {
+            gNumPlayers = 1;
+            gCourseIndex = 0;          // Mute City
+            gTotalLapCount = 3;
+            gPlayerCharacters[0] = 0;  // Captain Falcon
+            gPlayerMachineSkins[0] = 0;
+            gPlayerEngine[0] = 0.5f;
+            gCurrentGhostType = 0;
+            gTitleDemoState = 0;
+            gSelectedMode = 1;          // MODE_TIME_ATTACK
+            gCurrentTrackName = gTrackNames[gCourseIndex];
+            gQueuedGameMode = 14;       // GAMEMODE_TIME_ATTACK
+            time_attack_queued = true;
+            std::fprintf(stderr, "[headless] queued Time Attack through normal transition\n");
+        }
+
+        /* A deliberately weak control oracle: once the race overlay owns the game, hold the real
+           N64 A button through the existing raw-pad bridge. It should accelerate from the grid and
+           eventually fail a corner, proving that gameplay consumes host-injected controls. */
+        if (queue_time_attack && ((gGameMode & 0x1F) == 14)) {
+            gdx_headless_set_pad(0x8000u, 0, 0); // BTN_A
+        } else {
+            gdx_headless_clear_pad();
+        }
+
+        gdx_controller_poll();
+        gdx_headless_clock_advance_vi();
+        gdx_vi_tick();
+        gdx_sched_drain_deferred_wakes();
+        gdx_dispatch();
+
+        if (i == 0 || ((i + 1) % 60) == 0) {
+            std::fprintf(stderr,
+                         "[headless] vi=%d game_frame=%d mode=%d queued=%d change=%d "
+                         "racers=%d intro=%d speed=%.3f distance=%.3f lap=%d flags=%08x "
+                         "pos=(%.2f,%.2f,%.2f) gfx_tasks=%llu\n",
+                         i + 1, gGameFrameCount, gGameMode, gQueuedGameMode,
+                         static_cast<int>(gGameModeChangeState), gTotalRacers, gRaceIntroTimer,
+                         gRacers[0].speed, gRacers[0].raceDistance, gRacers[0].lap,
+                         static_cast<unsigned int>(gRacers[0].stateFlags),
+                         gRacers[0].segmentPositionInfo.pos.x,
+                         gRacers[0].segmentPositionInfo.pos.y,
+                         gRacers[0].segmentPositionInfo.pos.z,
+                         gdx_headless_gfx_task_count());
+        }
+    }
+
+    std::printf("HEADLESS_SMOKE_OK vi=%d game_frame=%d mode=%d queued=%d change=%d "
+                "racers=%d intro=%d time_attack_queued=%d "
+                "gfx_tasks=%llu gfx_bytes=%llu gfx_hash=%016llx cycles=%llu\n",
+                ticks, gGameFrameCount, gGameMode, gQueuedGameMode,
+                static_cast<int>(gGameModeChangeState), gTotalRacers, gRaceIntroTimer,
+                time_attack_queued ? 1 : 0,
+                gdx_headless_gfx_task_count(), gdx_headless_gfx_byte_count(),
+                gdx_headless_gfx_hash(), gdx_headless_clock_cycles());
+    return 0;
+}
diff --git a/port/rl/gdx_rl_dlmopen_test.cpp b/port/rl/gdx_rl_dlmopen_test.cpp
new file mode 100644
index 0000000..8d7a0f9
--- /dev/null
+++ b/port/rl/gdx_rl_dlmopen_test.cpp
@@ -0,0 +1,184 @@
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+
+#include "gdx_rl_env.h"
+
+#include <dlfcn.h>
+#include <link.h>
+
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+
+namespace {
+
+struct Api {
+    void* handle;
+    uint32_t (*abi_version)(void);
+    void (*default_config)(GdxRlConfig*);
+    int (*init)(const char*, const GdxRlConfig*);
+    int (*reset)(uint32_t, float*);
+    int (*step)(const int32_t*, float*, GdxRlTransition*);
+    uint64_t (*semantic_hash)(void);
+    const char* (*last_error)(void);
+};
+
+template <typename T>
+bool load_symbol(void* handle, const char* name, T* output) {
+    dlerror();
+    *output = reinterpret_cast<T>(dlsym(handle, name));
+    const char* error = dlerror();
+    if (error != nullptr || *output == nullptr) {
+        std::fprintf(stderr, "dlsym(%s) failed: %s\n", name, error != nullptr ? error : "null symbol");
+        return false;
+    }
+    return true;
+}
+
+bool load_api(const char* library_path, Api* api) {
+    std::memset(api, 0, sizeof(*api));
+    api->handle = dlmopen(LM_ID_NEWLM, library_path, RTLD_NOW | RTLD_LOCAL);
+    if (api->handle == nullptr) {
+        std::fprintf(stderr, "dlmopen failed: %s\n", dlerror());
+        return false;
+    }
+    return load_symbol(api->handle, "gdx_rl_abi_version", &api->abi_version) &&
+           load_symbol(api->handle, "gdx_rl_default_config", &api->default_config) &&
+           load_symbol(api->handle, "gdx_rl_init", &api->init) &&
+           load_symbol(api->handle, "gdx_rl_reset", &api->reset) &&
+           load_symbol(api->handle, "gdx_rl_step", &api->step) &&
+           load_symbol(api->handle, "gdx_rl_semantic_hash", &api->semantic_hash) &&
+           load_symbol(api->handle, "gdx_rl_last_error", &api->last_error);
+}
+
+int api_error(const char* label, const Api& api) {
+    std::fprintf(stderr, "%s: %s\n", label, api.last_error != nullptr ? api.last_error() : "unknown error");
+    return 1;
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    if (argc != 3) {
+        std::fprintf(stderr, "usage: %s <libgdiffuser_rl.so> <baserom.us.rev0.z64>\n", argv[0]);
+        return 2;
+    }
+
+    Api first;
+    Api second;
+    Api invalid;
+    if (!load_api(argv[1], &invalid) || !load_api(argv[1], &first) || !load_api(argv[1], &second)) {
+        return 1;
+    }
+    if (invalid.abi_version() != GDX_RL_ABI_VERSION || first.abi_version() != GDX_RL_ABI_VERSION ||
+        second.abi_version() != GDX_RL_ABI_VERSION) {
+        std::fprintf(stderr, "unexpected F-Zero RL ABI version\n");
+        return 1;
+    }
+
+    /* A bad explicit path must return to the trainer. It must neither exit nor fall through to an
+       inherited FZEROX_ROM that happens to name a valid image. */
+    GdxRlConfig invalid_config;
+    invalid.default_config(&invalid_config);
+    setenv("FZEROX_ROM", argv[2], 1);
+    const int invalid_result = invalid.init("/__gdiffuser_rl_missing_rom__.z64", &invalid_config);
+    unsetenv("FZEROX_ROM");
+    if (invalid_result == 0) {
+        std::fprintf(stderr, "invalid explicit ROM path unexpectedly initialized\n");
+        return 1;
+    }
+
+    GdxRlConfig first_config;
+    GdxRlConfig second_config;
+    first.default_config(&first_config);
+    second.default_config(&second_config);
+    first_config.laps = second_config.laps = 1;
+    first_config.cpu_oracle = second_config.cpu_oracle = 1;
+    first_config.stall_frames = second_config.stall_frames = 0;
+    if (first.init(argv[2], &first_config) != 0) {
+        return api_error("first namespace init failed", first);
+    }
+    if (second.init(argv[2], &second_config) != 0) {
+        return api_error("second namespace init failed", second);
+    }
+
+    constexpr uint32_t seed = 0xD1A0F20u;
+    float first_observation[GDX_RL_OBSERVATION_SIZE];
+    float second_observation[GDX_RL_OBSERVATION_SIZE];
+    if (first.reset(seed, first_observation) != 0) {
+        return api_error("first namespace reset failed", first);
+    }
+    if (second.reset(seed, second_observation) != 0) {
+        return api_error("second namespace reset failed", second);
+    }
+    if (std::memcmp(first_observation, second_observation, sizeof(first_observation)) != 0 ||
+        first.semantic_hash() != second.semantic_hash()) {
+        std::fprintf(stderr, "isolated namespaces disagree immediately after same-seed reset\n");
+        return 1;
+    }
+
+    const int32_t neutral[GDX_RL_ACTION_SIZE] = { 0, 0, 0, 0, 0 };
+    uint32_t physics_ticks = 0;
+    uint32_t previous_episode_frame = 0;
+    uint32_t decisions = 0;
+    uint32_t episodes = 0;
+    while (physics_ticks < 10000) {
+        const uint64_t untouched_hash = second.semantic_hash();
+        GdxRlTransition first_transition = {};
+        GdxRlTransition second_transition = {};
+        if (first.step(neutral, first_observation, &first_transition) != 0) {
+            return api_error("first namespace step failed", first);
+        }
+        if (second.semantic_hash() != untouched_hash) {
+            std::fprintf(stderr, "stepping namespace A mutated namespace B at decision %u\n", decisions);
+            return 1;
+        }
+        if (second.step(neutral, second_observation, &second_transition) != 0) {
+            return api_error("second namespace step failed", second);
+        }
+        if (std::memcmp(first_observation, second_observation, sizeof(first_observation)) != 0 ||
+            std::memcmp(&first_transition, &second_transition, sizeof(first_transition)) != 0) {
+            std::fprintf(stderr,
+                         "namespace parity mismatch at decision %u: first=%016llx second=%016llx\n",
+                         decisions, static_cast<unsigned long long>(first_transition.semantic_hash),
+                         static_cast<unsigned long long>(second_transition.semantic_hash));
+            return 1;
+        }
+        if (first_transition.episode_frame < previous_episode_frame) {
+            std::fprintf(stderr, "episode frame moved backward without reset\n");
+            return 1;
+        }
+        physics_ticks += first_transition.episode_frame - previous_episode_frame;
+        previous_episode_frame = first_transition.episode_frame;
+        decisions++;
+        if (first_transition.terminated || first_transition.truncated) {
+            if (!first_transition.terminated || first_transition.reason != GDX_RL_FINISHED) {
+                std::fprintf(stderr, "CPU oracle ended without a finish at decision %u\n", decisions);
+                return 1;
+            }
+            episodes++;
+            previous_episode_frame = 0;
+            const uint32_t next_seed = seed + episodes;
+            if (first.reset(next_seed, first_observation) != 0) {
+                return api_error("first namespace replay reset failed", first);
+            }
+            if (second.reset(next_seed, second_observation) != 0) {
+                return api_error("second namespace replay reset failed", second);
+            }
+            if (std::memcmp(first_observation, second_observation, sizeof(first_observation)) != 0 ||
+                first.semantic_hash() != second.semantic_hash()) {
+                std::fprintf(stderr, "namespace parity mismatch after episode reset\n");
+                return 1;
+            }
+        }
+    }
+
+    const uint64_t final_hash = first.semantic_hash();
+    std::printf("RL_DLMOPEN_ISOLATION_OK namespaces=2 decisions=%u physics_ticks=%u episodes=%u "
+                "semantic_hash=%016llx\n",
+                decisions, physics_ticks, episodes, static_cast<unsigned long long>(final_hash));
+    /* The game owns live ucontexts and process-lifetime caches. Intentionally let process exit
+       instead of dlclose()ing either namespace out from underneath them. */
+    return 0;
+}
