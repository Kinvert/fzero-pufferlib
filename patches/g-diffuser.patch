+/* ------------------------------------------------------------------------------------------ */
+/* In-memory save/ghost services. No host files are read or written.                           */
+/* ------------------------------------------------------------------------------------------ */
+
+static unsigned char sHeadlessSram[GDX_HEADLESS_SRAM_SIZE];
+
+void gdx_sram_init(void) {}
+
+void gdx_sram_read(unsigned int offset, void* dst, unsigned int size) {
+    if (dst == NULL) return;
+    if (offset > GDX_HEADLESS_SRAM_SIZE || size > GDX_HEADLESS_SRAM_SIZE - offset) {
+        memset(dst, 0, size);
+        return;
+    }
+    memcpy(dst, sHeadlessSram + offset, size);
+}
+
+void gdx_sram_write(unsigned int offset, const void* src, unsigned int size) {
+    if (src == NULL) return;
+    if (offset > GDX_HEADLESS_SRAM_SIZE || size > GDX_HEADLESS_SRAM_SIZE - offset) return;
+    memcpy(sHeadlessSram + offset, src, size);
+}
+
+int gdx_ghost_library_archive_sram(void) { return -1; }
+int gdx_ghost_library_load_selected(int encoded_course_index, void* ghosts, int capacity) {
+    (void) encoded_course_index;
+    (void) ghosts;
+    (void) capacity;
+    return 0;
+}
+int gdx_ghost_library_has_player(int encoded_course_index) {
+    (void) encoded_course_index;
+    return 0;
+}
+int gdx_ghost_library_save_player(int course_index, const void* ghost) {
+    (void) course_index;
+    (void) ghost;
+    return -1;
+}
+int gdx_ghost_library_get_player_stats(int encoded_course_index, int* race_time, int* checksum) {
+    (void) encoded_course_index;
+    if (race_time != NULL) *race_time = 0;
+    if (checksum != NULL) *checksum = 0;
+    return -1;
+}
+
+/* ------------------------------------------------------------------------------------------ */
+/* Raw-ROM-only resource policy. The segment source and resolver provide the actual fallback.  */
+/* ------------------------------------------------------------------------------------------ */
+
+int GDiffuser_LoadAssetBytes(const char* key, void* out, size_t out_size, size_t* copied_size) {
+    (void) key;
+    (void) out;
+    (void) out_size;
+    if (copied_size != NULL) *copied_size = 0;
+    return 0;
+}
+
+int GDiffuser_LoadArchiveFileBytes(const char* key, void* out, size_t out_size, size_t* copied_size) {
+    (void) key;
+    (void) out;
+    (void) out_size;
+    if (copied_size != NULL) *copied_size = 0;
+    return 0;
+}
+
+void GDiffuser_RegisterLoadedAssetBuffer(const void* buffer, size_t size, const char* key) {
+    (void) buffer;
+    (void) size;
+    (void) key;
+}
+
+/* ------------------------------------------------------------------------------------------ */
+/* Presentation sinks. CPU display-list construction remains live in the decomp.               */
+/* ------------------------------------------------------------------------------------------ */
+
+typedef struct GdxHeadlessFramebuffer {
+    void* address;
+    unsigned int width;
+    unsigned int height;
+} GdxHeadlessFramebuffer;
+
+static GdxHeadlessFramebuffer sHeadlessFramebuffers[GDX_HEADLESS_MAX_FRAMEBUFFERS];
+static int sHeadlessFramebufferCount;
+static void* sHeadlessCurrentFramebuffer;
+static void* sHeadlessNextFramebuffer;
+static unsigned long long sHeadlessGfxTasks;
+static unsigned long long sHeadlessGfxBytes;
+static unsigned long long sHeadlessGfxHash = 1469598103934665603ULL;
+
+void gdx_gfx_run(void* dl, size_t dl_size, GdxTaskUcode task_ucode) {
+    const unsigned char* bytes = (const unsigned char*) dl;
+    size_t i;
+    (void) task_ucode;
+    sHeadlessGfxTasks++;
+    sHeadlessGfxBytes += (unsigned long long) dl_size;
+    if (bytes == NULL) return;
+    for (i = 0; i < dl_size; ++i) {
+        sHeadlessGfxHash ^= bytes[i];
+        sHeadlessGfxHash *= 1099511628211ULL;
+    }
+}
+
+unsigned long long gdx_headless_gfx_task_count(void) { return sHeadlessGfxTasks; }
+unsigned long long gdx_headless_gfx_byte_count(void) { return sHeadlessGfxBytes; }
+unsigned long long gdx_headless_gfx_hash(void) { return sHeadlessGfxHash; }
+
+void gdx_register_n64_framebuffer(void* cpu_addr, unsigned int width, unsigned int height) {
+    int i;
+    size_t size;
+    if (cpu_addr == NULL || width == 0 || height == 0) return;
+    for (i = 0; i < sHeadlessFramebufferCount; ++i) {
+        if (sHeadlessFramebuffers[i].address == cpu_addr) return;
+    }
+    if (sHeadlessFramebufferCount < GDX_HEADLESS_MAX_FRAMEBUFFERS) {
+        sHeadlessFramebuffers[sHeadlessFramebufferCount].address = cpu_addr;
+        sHeadlessFramebuffers[sHeadlessFramebufferCount].width = width;
+        sHeadlessFramebuffers[sHeadlessFramebufferCount].height = height;
+        sHeadlessFramebufferCount++;
+    }
+    size = (size_t) width * (size_t) height * sizeof(unsigned short);
+    gdx_register_host_range(cpu_addr, size);
+}
+
+void gdx_vi_set_next_framebuffer(void* cpu_addr) { sHeadlessNextFramebuffer = cpu_addr; }
+void gdx_vi_set_current_framebuffer(void* cpu_addr) {
+    sHeadlessCurrentFramebuffer = cpu_addr;
+    (void) sHeadlessNextFramebuffer;
+}
+
+int gdx_read_current_framebuffer(void* rgba16, unsigned int width, unsigned int height) {
+    size_t size;
+    if (rgba16 == NULL || sHeadlessCurrentFramebuffer == NULL || width == 0 || height == 0) return 0;
+    size = (size_t) width * (size_t) height * sizeof(unsigned short);
+    if (rgba16 != sHeadlessCurrentFramebuffer) {
+        memmove(rgba16, sHeadlessCurrentFramebuffer, size);
+    }
+    return 1;
+}
+
+void gdx_diag_note_transition_capture(void* ptr, size_t size) { (void) ptr; (void) size; }
+void gdx_interp_mark_cut(void) {}
+void gdx_interp_mark_cut_src(const char* tag) { (void) tag; }
+
+/* Script-only presentation controls are inert in a library environment. */
+void gdx_request_quit(void) {}
+void gdx_request_frame_dump(const char* label) { (void) label; }
+
+/* ------------------------------------------------------------------------------------------ */
+/* Fixed stock presentation policy and enhancement/event defaults.                            */
+/* ------------------------------------------------------------------------------------------ */
+
+static int sHeadlessForceFixedAspect;
+
+int CVarGetInteger(const char* name, int default_value) { (void) name; return default_value; }
+float WindowGetAspectRatio(void) { return 4.0f / 3.0f; }
+void gdx_set_force_fixed_aspect(int enabled) { sHeadlessForceFixedAspect = enabled != 0; }
+int gdx_get_force_fixed_aspect(void) { return sHeadlessForceFixedAspect; }
+float gdx_get_ultrawide_cull_xscale(void) { return 1.0f; }
+float gdx_get_widescreen_geometry_xscale(void) { return 1.0f; }
+void GameEvents_FireOnBoostStart(int racer_id, int* frames) { (void) racer_id; (void) frames; }
+
+/* Globals normally owned by libultraship/n64_gfx_bridge/n64_leo. */
+int gGdxRaceActive;
+int gGdxCountdownProbeArm;
+unsigned int gGdxCountdownProbeVtxLow32;
+unsigned long long gGdxCountdownProbeResolvedVtx;
+LEODiskID leoBootID;
