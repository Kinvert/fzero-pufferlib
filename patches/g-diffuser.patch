+    if (!gdx_rom_is_us_rev0(gdx_rom_buffer, gdx_rom_size)) {
+        gdx_port_logf("[rom] REJECTED %s: expected exact US rev0 SHA-1 "
+                      "5f658e88ffa9de23cba6986a8fd3d3a90d7b4340\n",
+                      path);
+        free(gdx_rom_buffer);
+        gdx_rom_buffer = nullptr;
+        gdx_rom_size = 0;
+        gdx_rom_path[0] = '\0';
+        return -1;
+    }
+    gdx_port_logf("[rom] verified US rev0 SHA-1\n");
+    return 0;
+}
