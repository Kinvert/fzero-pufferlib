+
+namespace {
+
+constexpr std::size_t kMaxPlainAssetBytes = 8u * 1024u * 1024u;
+constexpr std::size_t kVenueBuildingTextureBytes = 0x800u;
+
+struct HostRange {
+    std::uintptr_t begin = 0;
+    std::size_t size = 0;
+};
+
+struct N64AddressRange {
+    std::uint32_t n64Begin = 0;
+    std::uintptr_t hostBegin = 0;
+    std::size_t size = 0;
+};
+
+struct ModuleRange {
+    std::uintptr_t begin = 0;
+    std::uintptr_t end = 0;
+
+    bool valid() const {
+        return begin != 0 && end > begin;
+    }
+};
+
+struct AssetSegmentLookup {
+    std::uint8_t segment = 0;
+    std::uint32_t romBase = 0;
+    bool compressed = false;
+    std::uint32_t offset = 0;
+    std::uint32_t imageSize = 0;
