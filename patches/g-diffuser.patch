diff --git a/tools/build_render_eval.sh b/tools/build_render_eval.sh
new file mode 100755
index 0000000..9fa51d3
--- /dev/null
+++ b/tools/build_render_eval.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+repo_dir="$(cd -- "${script_dir}/.." && pwd)"
+deps_build="${repo_dir}/build/render-deps"
+python_env="${repo_dir}/build/render-python"
+render_build="${repo_dir}/build/render-eval"
+
+if ! command -v uv >/dev/null 2>&1; then
+    echo "error: uv is required to create the repository-local Python environment" >&2
+    exit 1
+fi
+
+# CMake's build-time recipe generator imports Pillow and PyYAML. Keep both in
+# an ignored environment inside build/ rather than changing system Python.
+export UV_CACHE_DIR="${repo_dir}/build/uv-cache"
+if [[ ! -x "${python_env}/bin/python" ]]; then
+    uv venv "${python_env}"
+fi
+uv pip install --python "${python_env}/bin/python" pillow==12.3.0 pyyaml==6.0.3
+
+# libultraship's four non-system CMake packages are pinned to the same versions
+# as the Linux release workflow and installed only beneath build/render-deps.
+cmake -S "${repo_dir}/tools/render_eval_deps" -B "${deps_build}" -G Ninja \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_INSTALL_PREFIX="${deps_build}/install"
+cmake --build "${deps_build}" --target install -j "$(nproc)"
+
+cmake -S "${repo_dir}" -B "${render_build}" -G Ninja \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DGDX_EXPANSION_KIT=OFF \
+    -DCMAKE_PREFIX_PATH="${deps_build}/install" \
+    -DPython3_EXECUTABLE="${python_env}/bin/python"
+cmake --build "${render_build}" --target G-Diffuser -j "$(nproc)"
+
+echo "built ${render_build}/port/G-Diffuser"
