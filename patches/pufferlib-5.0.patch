+static void set_config(Dict* kwargs, const char* core_path) {
+    kwargs->name = dict_strdup("env");
+    dict_set_str(kwargs, "core_lib_path", core_path);
+    dict_set_str(kwargs, "rom_path", "/fake/rom.z64");
