index 00000000..cfce1018
--- /dev/null
+++ b/config/fzero.ini
@@ -0,0 +1,91 @@
+[base]
+env_name = fzero
+# Puffer/model sampling seed; independent from the reset stream under [env].
+seed = 73
+async = 0
+cudagraphs = -1
+checkpoint_interval = 100
+eval_episodes = 8
+
+[vec]
+# Each loaded F-Zero module owns one global game. Start with exactly one
+# environment, one rollout buffer, and one worker thread.
+total_agents = 1
+num_buffers = 1
+num_threads = 1
+num_policies = 1
+hist_policy_percent = 0
+
+[env]
+core_lib_path = ../G-Diffuser/build/rl-headless/port/libgdiffuser_rl.so
+rom_path = ../private/baserom.us.rev0.z64
+# Environment reset-sequence seed. Solo Mute City is currently invariant to
+# this seed for tested traces; task generalization needs explicit variants.
+seed = 73
+course_index = 0
+character = 0
+machine_skin = 0
+laps = 1
+# Action repeat is implemented inside gdx_rl_step; do not add Puffer frameskip.
+action_repeat = 4
+max_episode_frames = 9000
+stall_frames = 600
+stall_progress = 100.0
+engine_balance = 0.5
+cpu_oracle = 0
+# First curriculum: learn steering while masking pitch neutral, throttle on,
+# brake off, and boost off. Set to 0 to expose all five action heads.
+steering_curriculum = 1
+# Puffer clips learner rewards to [-1, 1]. Nonterminal progress and dash
+# shaping are scaled before rollout storage. Terminal outcomes bypass this
+# scale: a completed lap is in [0, 1], fatal failure is -1, and truncation is 0.
+reward_scale = 0.03125
+# A completed one-lap run scores clamp(target / successful_frames, 0, 1).
+# Set 0 for compatibility scoring where every completed lap receives 1.
+finish_time_target_frames = 2000
+# Optional shaping paid once when the exact core detects entry onto a dash pad.
+# Kept off by default; use 0.1 for the Mute City booster experiment.
+dash_hit_reward = 0
+
+[policy]
+hidden_size = 128
+num_layers = 2
+
+[train]
+gpus = 1
+# Puffer cosine-anneals the learning rate across this horizon. Keep the default
+# equal to the validated first phase; longer runs need an explicit schedule.
+total_timesteps = 65_536
+# The original 3e-4/replay-1 defaults did not measurably learn in 65,536
+# decisions. This recipe reached 81.25% finishes in its first 65,536-decision
+# phase; the README documents the lower-LR continuation that reached 90.23%.
+learning_rate = 0.003
+anneal_lr = 1
+replay_ratio = 4
+ent_coef = 0.0001
+gamma = 0.999
+gae_lambda = 0.95
+minibatch_size = 128
+horizon = 128
+
+[sweep]
+gpus = 1
+max_runs = 40
+
+# Keep F-Zero's one-runtime layout and coupled horizon/minibatch geometry fixed
+# until namespace scaling is benchmarked. Puffer's inherited sweep dimensions
+# would otherwise assert on invalid independent combinations.
+[sweep.vec.total_agents]
+enabled = 0
+
+[sweep.train.horizon]
+enabled = 0
+
+[sweep.train.minibatch_size]
+enabled = 0
+
+[sweep.train.total_timesteps]
+distribution = log_normal
+min = 65536
+max = 10000000
+scale = time
